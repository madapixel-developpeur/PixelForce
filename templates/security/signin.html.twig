<!DOCTYPE html>
<html>
    <head>
        {% if app.environment == 'prod' %}
            <script async src="https://www.googletagmanager.com/gtag/js?id=G-8PBBKR57JN"></script>
            <script type="text/javascript" src="{{ asset('assets/js/google_analytics.js') }}"></script>
        {% endif %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="google-site-verification" content="O5bvNXZxdhGiT5VN5hPxisFh_XZeZCQr4aN4yoy0Ilk" />
        <title>{% block title %}Authentification!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        <link rel="stylesheet" href="/assets/fontawesome-free-6.0.0-web/css/all.css" />
        <link rel="stylesheet" href="{{ asset('/assets/vuexy/css/pages/authentication.css') }}" />
        <link rel="stylesheet" type="text/css" href="{{asset('assets/css/animations.css')}}">
        <link rel="stylesheet" type="text/css" href="{{asset('assets/css/style.css?date=202503251118')}}">
        <link rel="stylesheet" type="text/css" href="{{asset('assets/css/inscription.css?date=202503260739')}}">
        <link rel="stylesheet" href="{{ asset('assets/css/sweetalert2/sweetalert2.min.css')}}">
        
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('vuexy_colors') }}
            {{ encore_entry_link_tags('vuexy_components') }}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        <script src="{{ asset('assets/vuexy/vendors/js/vendors.min.js') }}" ></script>
        <style>
            .form-step {
                display: none;
            }
            .form-step.active {
                display: block;
            }

            .account-info {
                border: 1px solid #ccc;
                padding: 15px;
                margin-bottom: 15px;
                border-radius: 5px;
            }

         

        </style>
        {% block javascripts %}
            {{ encore_entry_script_tags('vuexy_app') }}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    <body>
{% block body %}
<body class="horizontal-layout horizontal-menu blank-page navbar-floating footer-static  " data-open="hover" data-menu="horizontal-menu" data-col="blank-page">
    <div class="app-content content ">
        <div class="content-overlay"></div>
        <div class="header-navbar-shadow"></div>
        <div class="content-wrapper">
            <div class="content-header row">
            </div>
            <div class="content-body">
                <div class="auth-wrapper auth-cover">
                    <div class="auth-inner row m-0">
                        

                        <!-- Left Text-->
                        <div class="d-none d-lg-flex col-md-7 align-items-center m-0 p-0 bg-image">
                        </div>
                        <!-- /Left Text-->
                        <!-- Login-->
                        <div class=" col-md-5 auth-bg px-1 d-flex flex-column justify-content-center align-items-center">
                            <div class="col-12 col-sm-8 col-md-8 col-lg-12 p-lg-3 mx-auto flex-grow-1">
                                <div class="p-lg-4 p-3">
                                    <h2 class="card-title   text-center  pixelforce-logo">
                                            <a href="{{ path('app_dashboard') }}" class="text-center text-muted  d-flex align-items-center justify-content-center ">
                                                <img src="/assets/img/logo/pixelforce/logo-pixelforce-00.png" class="img-fluid  m-2" alt="logo-pixelforce">
                                                <h2 class="ml-0 fw-bold">PIXELFORCE</h2>
                                            </a> 
                                             
                                    </h2>
                                    
                                    {% block form %}
                                 
                                    <h2 class="text-center fw-bold mb-3">Inscription</h2>
                                        <!-- Message alert -->
                                            <div class="alert-message">
                                                {% for label, messages in app.flashes %}
                                                    <div class="alert alert-{{label}} text-center">
                                                        {% for message in messages %}
                                                            {{message | raw}}
                                                        {% endfor %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {{ form_start(form) }}
                                            <div class="form-step {% if currentStep == 0 %}active{% endif %}" id="step-0">
                                                 <h5 class="mt-4 mb-3">Information du compte</h5>
                                                <div class="row">
                                                    <div class="col-md-12 col-12">
                                                        {{ form_row(form.pays) }}
                                                    </div>
                                                </div>
                                                <label class=" mb-3">Type</label>
                                                <div class="toggle-buttons mb-3">
                                                    {{ form_errors(form.roles) }}
                                                    {% for choice in form.roles.vars.choices %}
                                                        <input type="checkbox"
                                                            id="{{ choice.value }}"
                                                            name="{{ form.roles.vars.full_name }}[]"
                                                            value="{{ choice.value }}"
                                                            class="toggle-input"
                                                            {% if choice.value in form.roles.vars.data %}checked{% endif %}
                                                        >
                                                        <label for="{{ choice.value }}" class="toggle-button">
                                                            <span class="toggle-label">{{ choice.label }}</span>
                                                            <span class="checkmark"><i class="fas fa-check"></i></span>
                                                            <span class="lock-icon d-none" id="{{ choice.value ~ '_lock' }}"><i class="fas fa-lock"></i></span>
                                                        </label>
                                                    {% endfor %}
                                                </div>
                                         

                                               <div style="margin-top: 15px;" class="account-info">
                                                    <p style="font-weight: bold; margin-bottom: 5px;">Compte Revendeur</p>
                                                    <p style="font-size: 0.9em; color: #777;">
                                                        **Vous souhaitez proposer des services ?**  
                                                        Optez pour le compte Revendeur pour accéder à une sélection de services et les intégrer à votre offre.
                                                    </p>
                                                    <p class="highlight" style="font-size: 0.9em;">
                                                        Parfait pour les intermédiaires ou une offre complète sans tout réaliser en interne.
                                                    </p>
                                                </div>

                                                <div class="account-info">
                                                    <p style="font-weight: bold; margin-bottom: 5px;">Compte Professionnel (Pro) <span id="restriction" style=" font-size: 0.9em; color: #d9534f; "></span> </p>
                                                    <p style="font-size: 0.9em; color: #777;">
                                                        **Vous proposez des services ?**  
                                                        Créez un compte Pro pour valoriser vos compétences et proposer vos prestations à un large public.
                                                    </p>
                                                    <p style="font-size: 0.9em; color: #777;">
                                                        Vous gérez vos projets et interagissez avec votre clientèle en toute autonomie.
                                                    </p>
                                                    <p class="highlight" style="font-size: 0.9em;">
                                                        Idéal si vous réalisez vous-même les prestations.
                                                    </p>
                                                </div>

                                                <div class="w-100 text-end">
                                                    <button   type="button" name="currentStep" value="0" class="next-step btn-primary font-weight-bold rounded-3 p-2">Suivant</button>
                                                </div>
                                            </div>
                                            <div class="form-step {% if currentStep == 1 %}active{% endif %}" id="step-1">
                                                 <h5 class="mt-4 mb-3">Information</h5>
                                                <div class="row">
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.prenom) }}
                                                    </div>
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.nom) }}
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.email) }}
                                                    </div>
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.telephone) }}
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.numero_rue) }}
                                                    </div>
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.adresse) }}
                                                    </div>
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.codePostal) }}
                                                    </div>
                                                    <div class="col-md-6 col-12">
                                                        {{ form_row(form.ville) }}
                                                    </div>
                                                </div>
                                               
                                                {# <h5 class="mt-4">Choix du secteur</h5>
                                                <div class="row my-3">
                                                    {% for secteurList in form.secteur.children.secteur.children %}
                                                        <div class="col-12 col-md-4">
                                                            {{ form_row(secteurList) }}
                                                        </div>

                                                    {% endfor %}
                                                </div> #}
                                                
                                                <div class="d-flex justify-content-between">  
                                                    <button type="button" class="prev-step  btn-primary font-weight-bold rounded-3 p-2">Retour</button>
                                                    <button type="button" name="currentStep" value="1" class="next-step  btn-primary font-weight-bold rounded-3 p-2">Suivant</button>
                                                </div>
                                            </div>
                                            <div class="form-step {% if currentStep == 2 %}active{% endif %}" id="step-2">
                                                <h5 class="mt-4 mb-3">Information sur la connexion</h5>
                                                {% if form.ambassador_username is defined %}
                                                    {{ form_row(form.ambassador_username) }}
                                                {% endif %}

                                                {{ form_row(form.username,{ 'attr': { 'autocomplete': 'off' } }) }}
                                                <div class="input-group mb-3">
                                                    {{ form_widget(form.password.first) }}
                                                    <span class="input-group-text cursor-pointer">
                                                        <i data-feather="eye"  class="icon-password"></i>
                                                    </span>
                                                    {{ form_errors(form.password.first) }}

                                                </div>

                                                <div class="input-group mb-3">
                                                    {{ form_widget(form.password.second) }}
                                                    <span class="input-group-text cursor-pointer" >
                                                        <i data-feather="eye" class="icon-password"></i>
                                                    </span>
                                                    {{ form_errors(form.password.second) }}

                                                </div>
                                                {% do form.roles.setRendered %}
                                            
                                                <div class="d-flex justify-content-between">  
                                                    {#            <button class="btn btn-primary" type="submit" id="btn-next">Procéder au paiement <i class="fa-solid fa-angles-right"></i></button>#}
                                    
                                                    <button type="button" class="prev-step btn-primary font-weight-bold rounded-3 p-2">Retour</button>
                                                    <button type="button" class="sign-in-button h-30 font-weight-bold rounded-3 p-2 next-step "  name="currentStep" value="3" id="btn-next">S’inscrire</button>
                                                </div>
                                            </div>

                                           

                                        {{ form_end(form) }}
                                        <div class="divider my-1">
                                            <hr/>
                                            </div>
                                        <div class="row mt-2 justify-content-center d-flex">
                                                <div class="col-12 ">
                                                    <div class=" text-center">
                                                        <a class="w-100 font-weight-bold login-other-button" href="{{ path('app_forgetPassword') }}">
                                                            Mot de passe oublié ?
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="col-12 ">
                                                    <div class=" text-center">
                                                        <a class=" w-100 font-weight-bold login-other-button " href="{{ path('app_login') }}">
                                                            Déjà un compte ? Connectez-vous
                                                        </a>
                                                    </div>
                                                </div>
                                                
                                            </div>    
                                    
                                    {% endblock %}


                                </div>
                            </div>
                            {{ include ('global/footer/auth_footer.html.twig') }}
                        </div>
                        <!-- /Login-->
                    </div>
                </div>
            </div>
        </div>
    </div>
     <script>
        $(window).on('load', function() {
            if (feather) {
                feather.replace({
                    width: 14,
                    height: 14
                });
            }
        })
    </script>
    <script  src="{{asset('assets/js/sweetalert2/sweetalert2.all.min.js')}}"></script>
    <script  src="{{asset('assets/js/sweetalert2/sweetalerts.js')}}"></script>
    <script>
        $(document).ready(function () {
            let currentStep = {{ currentStep }};
            const steps = $(".form-step");
            const nextBtns = $(".next-step");
            const prevBtns = $(".prev-step");

            $('.cursor-pointer').on('click', function () {
                var inputField = $(this).prev('input'); // The password input field
                if (inputField.attr('type') === 'password') {
                    inputField.attr('type', 'text');
                    $(this).find('.icon-password').attr('data-feather', 'eye-off');
                } else {
                    inputField.attr('type', 'password');
                    $(this).find('.icon-password').attr('data-feather', 'eye');
                }
                feather.replace();  // Re-initialize Feather icons
            });


            function showStep(step) {
                steps.each(function (index) {
                    $(this).toggleClass("active", index === step);
                });
            }

            // Function to validate the current step fields, including nested fields
            function validateCurrentStep() {
                let isValid = true;

                // Select all input, select, and textarea elements inside the current step, including nested elements
                const currentStepFields = $(`#step-${currentStep} input, #step-${currentStep} select, #step-${currentStep} textarea`);
                currentStepFields.each(function () {
                    if (!this.checkValidity()) {
                        $(this).addClass("is-invalid");  // Add invalid class to show error
                        isValid = false;
                    } else {
                        $(this).removeClass("is-invalid");  // Remove invalid class
                    }
                });

                return isValid;
            }

            // Next button logic
            nextBtns.each(function () {
                $(this).on("click", function (e) {
                    e.preventDefault();  // Prevent form submission
                    
                    if (validateCurrentStep()) {
                        if(currentStep == 0) {
                           const selectedRoles = $('input[name^="inscription_agent[roles][]"]:checked');
                           console.log(selectedRoles);
                            if (selectedRoles.length === 0) {
                                Swal.fire({ title: "Attention!", text: "Vous devez sélectionner au moins un type de compte !", type: "warning", confirmButtonClass: "btn long", buttonsStyling: !1 });
                                return;
                            }
                        }


                        if (currentStep < steps.length - 1) {
                            currentStep++;
                            showStep(currentStep);
                        }else{
                            $('#sign-up-form').submit();
                        }
                    } else {
                        // Trigger native validation message display
                        const invalidField = $(`#step-${currentStep} .is-invalid`).first();
                        if (invalidField.length) {
                            invalidField[0].reportValidity();  // This will show the browser's native validation message
                        }
                    }
                });
            });

            // Previous button logic
            prevBtns.each(function () {
                $(this).on("click", function () {
                    if (currentStep > 0) {
                        currentStep--;
                        showStep(currentStep);
                    }
                });
            });
            
            $('#inscription_agent_pays, #ROLE_PROFESSIONNEL').on('change', function() {
                let countryCode = $('#inscription_agent_pays').val();
                if(countryCode == "FR"){
                    $('#restriction').html(`<i class="fas fa-exclamation-triangle" style="margin-right: 5px;"></i>À ce jour, la plateforme n'est pas ouverte aux professionnels basés en France.`);
                    $("#ROLE_PROFESSIONNEL").prop("checked", false).prop("disabled", true).closest("label").addClass("disabled-label");
                    $("#ROLE_PROFESSIONNEL_lock").removeClass('d-none');
                }
                else{
                    $('#restriction').html(``);
                    $("#ROLE_PROFESSIONNEL").prop("disabled", false).closest("label").removeClass("disabled-label");
                    $("#ROLE_PROFESSIONNEL_lock").addClass('d-none');
                }
            });

            showStep(currentStep);
        });
    </script>
</body>
{% endblock %}