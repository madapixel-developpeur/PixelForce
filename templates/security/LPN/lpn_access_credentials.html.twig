{% extends 'base.html.twig' %}

{% block title %}
	Little Ponails - Login
{% endblock %}

{% block stylesheets %}
	{{ parent() }}

{% endblock %}

{% block body %}
	<div class="row px-3 content-formation">
		<div class="card card-body-custom mt-2 px-5 py-5">
			<div class="">
				<div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="mb-5 font-20  col-md-10 text-center">
                            <h3 class="text-center mb-3">{{ 'Accès Little Ponails'|trans }}</h3>
                            <p>{{ 'Veuillez entrer votre mot de passe Little Ponails pour continuer'|trans }}</p>
                        </div>
                        <div class="row mt-4">
                            <div class="col-12 ">
                                <div class="alert alert-info">
                                    {{ 'lpn_identification_note'|trans|raw}}
                                </div>
                            </div>
                        </div>   
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{label}}" role="alert">
                                    <div class="alert-body">
                                        {{message}}
                                    </div>
                                </div>
                            {% endfor %}
                        {% endfor %}
                        {{ form_start(form, {'attr': {'class': 'form signup-form', 'id': 'signup'}}) }}
                            {{ form_row(form.username) }}
                            {{ form_row(form.password) }}
                            <div class="d-flex justify-content-end mb-3">
                                <button type="submit" class="btn btn-primary text-end">{% trans %}Login{% endtrans %}</button>
                            </div>
                        {{form_end(form)}}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
{% block javascripts %}
	{{ parent() }}
    <script>
        $(document).ready(function () { 	
            $('#resend-code-btn').click(function (){
                $('#resend-code-form').submit();
            })
        });
	</script>
{% endblock %}
