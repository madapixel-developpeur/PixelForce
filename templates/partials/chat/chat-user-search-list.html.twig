<div class="chat-user-search-list d-flex flex-column" style="height: 100%; position: relative;" ng-controller="chatUserSearchList">
  <div class="chat-user-list-header">
    <div class="d-flex align-items-center">

      <i class="ti ti-chevron-left fs-2" style="cursor: pointer;" ng-click="goBack()"></i>

      <div class="ms-2" style="margin-bottom: 0;">
        <input type="text" class="form-control search-input" placeholder="Recherche" ng-model="chatSearch"
          ng-change="search()">
      </div>
      <i class="ti ti-search fs-1 ms-2"></i>
    </div>
  </div>
  <div class="chat-user-list-main">
    <div style="height:100%;" ng-if="isLoading">
      <div class="d-flex align-items-center justify-content-center" style="height: 100%;">
        <i class="ti ti-loader fs-2 my-loader"></i>
      </div>
    </div>
    <div style="height:100%;" ng-if="!isLoading">
      <div style="height:100%;" ng-if="total == 0 && chatSearch && chatSearch !== ''">
        <div class="d-flex align-items-center justify-content-center" style="height: 100%;">
          <span>Aucun résultat</span>
        </div>
      </div>


      <div class="d-flex p-3 chat-one-user new align-items-center" ng-if="!(chatSearch && chatSearch !== '') && '{{is_granted('ROLE_COACH') ? 1: 0}}' == '1'"
          ng-click="openModalCreateGroup()">
        <div class="chat-user-avatar-wrapper">
          <img src="{{ asset('assets/img/create-group.png') }}"
           class="chat-user-avatar" />
          </div>
        <div class="flex-grow-1 ms-2">
          
            <span class="fs-6">Créér un groupe</span>

        </div>

      </div>

      <div ng-repeat="user in data" class="d-flex p-3 chat-one-user new"
        ng-click="addConversation(user)">
        <div class="chat-user-avatar-wrapper {{ "{{getAvatarClassUser(user)}}" }}">
          <img ng-src="{{ '{{\'/user/avatar/\' + user.userId}}' }}"
          onerror='this.onerror=null; this.src="{{ asset('assets/img/avatar.webp') }}"'
           class="chat-user-avatar" />
          </div>
        <div class="flex-grow-1 d-flex flex-column justify-content-between ms-2">
          <div class="d-flex justify-content-between">
            <span><b>{{ "{{user.firstname}} {{user.lastname}}" }}</b></span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="fs-6 message-text">{{ "{{user.roleLabel | truncate:30}}" }}</span>

          </div>
          <div class="d-flex justify-content-between" >
            <span class="fs-6">{{ "{{user.email | truncate:30}}" }}</span>

          </div>
        </div>

      </div>

      <div class="d-flex p-3 align-items-center justify-content-center mb-2">
        <div class="d-flex flex-column align-items-center font-weight-bold" style="cursor: pointer;"
          ng-if="showLoadingMore && !isLoadingMore" ng-click="loadMore()">
          <i class="ti ti-chevron-down fs-2 " style="cursor: pointer;"></i>
          <span class="fs-6">Voir plus</span>

        </div>

        <i class="ti ti-loader fs-2 my-loader" ng-if="isLoadingMore"></i>
      </div>
    </div>
  </div>

  <div class="modal fade chat-modal" tabindex="-1" id="createGroupModal" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
    
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Créer un groupe</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <form name="myFormNewGroup" novalidate >
      <div class="modal-body">
        
    <div class="form-group">
  <label class="control-label col-sm-2" for="name">Nom:</label>
  <div class="col-sm-10">
    <input type="text" class="form-control" id="name" 
           ng-model="newGroup.name" name="name" required>
    <span ng-show="myFormNewGroup.name.$touched && myFormNewGroup.name.$error.required" 
          class="help-block">Nom obligatoire.</span>
  </div>
  
</div>
 <div class="form-group form-check">
    <input type="checkbox" class="form-check-input" id="isPublic" ng-model="newGroup.isPublic" name="isPublic">
    <label class="form-check-label" for="isPublic">Publique</label>
  </div>
      </div>
      
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="submit" ng-disabled="myFormNewGroup.$invalid || isCreateGroupLoading" ng-click="submitNewGroup()" class="btn btn-primary">
    <span ng-if="isCreateGroupLoading" class="my-spinner"></span>&nbsp;
        Enregistrer</button>
      </div>
       </form>
    </div>
  </div>
</div>


</div>

