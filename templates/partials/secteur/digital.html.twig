			<div class="d-flex flex-row  align-items-center mx-2">
				<i class="fas fa-medal fa-2x new-pixelforce-color"></i>
				<div class="my-auto ms-2">
					<h4 class="card-text font-small-1 mb-0 text-dark-template d-none d-xl-block">Statut</h4>
					<h6 class="fw-bolder mb-0 ">
						{{ dataStat.rankInfo.rankName }}
					</h6>

				</div>
			</div>
		</div>
	{% endif %}
