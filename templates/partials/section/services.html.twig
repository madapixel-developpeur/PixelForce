{% if services is not empty %}
<div class="row carousel-container carousel-service ">
	<div id="secteurCarousel" class="carousel carousel-dark slide mt-5" data-bs-ride="carousel">
		<div class="carousel-inner">
			{% for serviceGroup in services %}
				<div class="carousel-item {% if loop.first %}active{% endif %}">
					<div class="row">
						{% for service in serviceGroup %}
							<div class="col-lg-4 d-flex">
								<div
									class="bd-services-2__item text-center mb-30 wow fadeInUp card d-flex flex-column flex-grow-1">

									{# Title with fixed min-height to ensure alignment #}
									<div class="bd-services-2__title-wrapper mb-3" style="min-height: 60px;">
										<h3 class="bd-services-2__title mb-2">
											<a href="{{ service.redirectionUrl }}" target="_blank">
												{{ service.title|raw }}
											</a>
										</h3>
									</div>

									{# Aligned image section #}
                                    {% if service.image %}
                                        <div class="text-center mb-3" style="min-height: 60px;">
                                                <img src="{{ asset('files/') ~ service.image }}" alt="{{ service.image }}" style="max-height: 50px;">
                                        </div>
                                    {% else %}
                                        <div class="bd-services-2__icon text-center mb-3" style="min-height: 60px;">
											{# <img src="{{ asset('files/') ~ service.image }}" alt="{{ service.image }}" style="max-height: 50px;"> #}
									    </div>
                                    {% endif %}

									{# Content with stretched space, button pinned to bottom #}
									<div class="bd-services-2__content d-flex flex-column flex-grow-1">
										<p>{{ service.shortDescription }}</p>

										<div class="bd-services-2__item-btn mt-auto">
											<a href="{{ service.redirectionUrl }}" class="link-btn-2" target="_blank">
												{% trans %}Nos offres exclusives{% endtrans %}
												<i class="fas fa-angle-right"></i>
											</a>
										</div>
									</div>

								</div>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endfor %}
		</div>


		<button class="carousel-control-prev custom-command justify-content-start" type="button" data-bs-target="#secteurCarousel" data-bs-slide="prev">
			<i class="fa fa-angle-left color-pixelforce fs-3" aria-hidden="true"></i>
			<span class="visually-hidden">Previous</span>
		</button>
		<button class="carousel-control-next custom-command justify-content-end" type="button" data-bs-target="#secteurCarousel" data-bs-slide="next">
			<i class="fa fa-angle-right color-pixelforce fs-3" aria-hidden="true"></i>
			<span class="visually-hidden">Next</span>
		</button>

	</div>
</div>
{% endif %}
