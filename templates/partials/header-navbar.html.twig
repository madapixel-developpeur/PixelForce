<nav class="header-navbar navbar navbar-expand-lg align-items-center floating-nav navbar-light navbar-shadow ">
    <div class="navbar-container d-flex justify-content-center align-items-center">
        <ul class="nav navbar-nav d-block d-xl-none d-flex align-items-center">
            <li class="nav-item pt-2">
                <a class="navbar-brand" href="{{
                is_granted('ROLE_ADMINISTRATEUR') ? path('admin_dashboard') : (
                    is_granted('ROLE_AGENT') ? (
                        app.request.session.get('secteurId') ?
                            path('agent_dashboard_secteur', {id:app.request.session.get('secteurId')}) : path('agent_home')
                    )  : ( is_granted('ROLE_COACH') ? path('app_dashboard') : '#' ))
                }}">
                    <span><img src="/assets/img/logo/pixelforce/logo-pixelforce-00.png" class="img-fluid" alt="logo-pixelforce" width="35"></span>
                    <h2 class="brand-text text-black fw-bolder" style="font-size: 3vw">PIXELFORCE</h2>
                </a>
            </li>
           
          
            
            <li class="nav-item {% if hideMenu is defined and hideMenu  %}d-none{% endif %} pt-2">
                <a class="nav-link modern-nav-toggle pe-0 py-1" data-bs-toggle="collapse"><i class="fa fa-bars fs-5" aria-hidden="true"></i></a>
            </li>
          
            
        </ul>
        {% if not app.session.has('secteurId') and is_granted('ROLE_AGENT') %}
        <ul class="nav navbar-nav d-none d-xl-block">
            <li class="nav-item  pixelforce-logo ms-3">
               <div  class="text-center text-muted  d-flex align-items-center justify-content-center ">
                     <span><img src="/assets/img/logo/pixelforce/logo-pixelforce-00.png" class="img-fluid" alt="logo-pixelforce" width="35"></span>
                    <span class="brand-text text-black fw-bolder" style="">PIXELFORCE</span>
                </div> 
            </li>
        </ul>
        {% endif %}
        {% if is_granted('ROLE_AGENT') and app.session.get('secteurId') %}
        {% set statDigitalGlobalVariable = dataStat.statDigital %}
        {% set nbVentesTotalGlobalVariable = dataStat.nbVentesTotal %}
        {% set nbrRdvGlobalVariable = dataStat.nbrRdv %}
        {% set chiffreAffaireTotalGlobalVariable = dataStat.chiffreAffaireTotal %}
        {% set soldeRemunerationGlobalVariable = dataStat.soldeRemuneration %}
        {% set typeSecteurId = app.session.get('typeSecteurId') %}
        {% set isDemandeDevis = typeSecteurId == constant('App\\Entity\\TypeSecteur::DEMANDE_DEVIS') %}
        {% set isEcommerce = typeSecteurId == constant('App\\Entity\\TypeSecteur::ECOMMERCE') %}
        {% set statRemuneration = dataStat.statRemuneration %}
        {% set rankInfo = dataStat.rankInfo %}

       
        <ul class="d-none d-xl-block">
             <div class="d-flex align-items-center">


                {% if app.session.get('secteurId') == secteur_finance_id %}
                    {{ include ('partials/secteur/finance.html.twig') }}
                {% elseif app.session.get('secteurId') == secteur_little_ponails_id %}
                    {{ include ('partials/secteur/little_ponails.html.twig') }}
                {% elseif app.session.get('typeSecteurId') == type_secteur_securite_id %}
                    {{ include ('partials/secteur/security.html.twig') }}
                {% else %}
                    {{ include ('partials/secteur/digital.html.twig') }}
                {% endif %}
            </div>
        </ul>
        {% endif %}
      
        <ul class="nav navbar-nav align-items-center ms-auto">
            {% if  app.session.get('secteurId')  in [secteurDigitalId,secteur_little_ponails_id] %}
                <li class="me-3">
                    {% set route = app.request.attributes.get('_route') %}
                    {% set route_params = app.request.attributes.get('_route_params') %}
                    {% set params = route_params|merge(app.request.query.all) %}
                    <ul class="d-flex align-items-center flex-end " style="padding:5px; list-style-type:none; justify-content:flex-end;">
                        <li><a href="{{ path(route, params|merge({ lang: 'fr' })) }}"><img src="{{asset( "assets/flags/fr.png" ) }}" style="height: 15px;" alt="FR" /></a></li>
                        <li style="margin-left:10px; margin-right:10px"> | </li>
                        <li><a href="{{ path(route, params|merge({ lang: 'en' })) }}"><img src="{{asset( "assets/flags/en.png" ) }}"  style="height: 15px;" alt="EN" /></a></li>

                    </ul>
                </li>
            {% endif %}
            <li class="nav-item dropdown dropdown-user">      
                   <div class="d-flex align-items-center">
                        <div class="avatar me-3 ml-5">
                                <img class="round object-fit-cover h-100 w-100"
                                    src="{{ path('user_avatar', {id:app.user.id}) }}"
                                    onerror='this.onerror=null; this.src="{{ asset('assets/vuexy/images/portrait/small/avatar-s-11.jpg') }}"'
                                    alt="avatar" >
                        </div>

                        <div class="user-nav  me-2 d-none d-md-block">
                            <ul class="list-unstyled p-0">
                                {% if  app.session.get('secteurId')  not in [secteurDigitalId,secteur_little_ponails_id] or  (not app.session.has('secteurId') and is_granted('ROLE_AGENT'))  %}
                                    <li>
                                        {% set route = app.request.attributes.get('_route') %}
                                        {% set route_params = app.request.attributes.get('_route_params') %}
                                        {% set params = route_params|merge(app.request.query.all) %}
                                        <ul class="d-flex align-items-center flex-end " style="padding:5px; list-style-type:none; justify-content:flex-end;">
                                            <li><a href="{{ path(route, params|merge({ lang: 'fr' })) }}"><img src="{{asset( "assets/flags/fr.png" ) }}" style="height: 15px;" alt="FR" /></a></li>
                                            <li style="margin-left:10px; margin-right:10px"> | </li>
                                            <li><a href="{{ path(route, params|merge({ lang: 'en' })) }}"><img src="{{asset( "assets/flags/en.png" ) }}"  style="height: 15px;" alt="EN" /></a></li>

                                        </ul>
                                    </li>
                                {% endif %}
                                <li class="p-0">
                                    <span class="user-status header-user">{{ app.user.prenom|default(' ') }}</span>
                                    {# <span class="user-name header-user" >{{ app.user.nom }}</span> #}
                                </li>
                                
                                
                                {% if  app.session.get('secteurId')  in [secteurDigitalId,secteur_little_ponails_id] %}
                                <li class="d-flex p-0">
                                    <span class="">
                                        <a class="header-user text-primary" href="#"  onclick="copyLink('{{ url('agent_inscription', {'ambassador_username':  app.user.username != "" ?  app.user.username : ' '}) }}') " >
                                           {% trans %} Lien réseau{% endtrans %}
                                            <i class="fa-solid fa-copy"></i>
                                        </a>
                                    </span>
                                </li>
                                <li class="d-flex p-0">
                                    {% set productLink = generate_product_link(app.session.get('secteurId'),app.user.id) %}
                                    <span class="">
                                        <a class="header-user text-primary" href="#"  onclick="copyLink('{{ productLink  }}','{{'Votre lien produit a été copié avec succès' | trans }}') "  >
                                            {% trans %}Lien produit{% endtrans %}
                                            <i class="fa-solid fa-copy"></i>
                                        </a>
                                    </span>
                                </li>
                                {% endif %}
                            </ul>
                        </div>

                        <div>
                            <a class="nav-link dropdown-toggle dropdown-user-link" id="dropdown-user" href="#" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"><i class="fa-solid fa-caret-down"></i></a>
                        </div>
                    </div>


                
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdown-user">
                    <a class="dropdown-item" href="{{ path('user_accountSetting', {id:app.user.id}) }}"><i class="me-50" data-feather="user"></i> {% trans %}Mon compte{% endtrans %}</a>
                    <a class="dropdown-item" href="{{ path('app_logout') }}"><i class="me-50" data-feather="power"></i> {% trans %}Se déconnecter{% endtrans %}</a>
                </div>   
            </li>
        </ul>
    </div>
</nav>
