                    <div class="card">
                        <h4 class="pt-2 pb-2 mb-4"></h4>
                        <div  class="text-center text-muted  d-flex align-items-center justify-content-center pixelforce-logo mt-5 ">
                            <img src="/assets/img/logo/pixelforce/logo-pixelforce-00.png" class="img-fluid  m-2" alt="logo-pixelforce">
                            <h2 class="ml-0 fw-bold">PIXELFORCE</h2>
                        </div> 
                        <div class="row mb-4 justify-content-center mx-4">
                            <div class="col-md-12 text-center ">
                                <h4 class="text-center mb-4">
                                {% if type == "CGU"  %}
