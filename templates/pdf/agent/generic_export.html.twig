<!DOCTYPE html>
<html>
<head>
    <title>{{ title }}</title>
    <style>
        body {
            font-family: sans-serif;
            font-size: 12px;
            line-height: 1.5;
            color: #333;
        }

        h1 {
            font-size: 20px;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        th {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .text-center{
            text-align:center;
        }

        .text-start , .text-left{
            text-align: left;
        }

        .text-end , .text-right{
            text-align: right;
        }
    </style>
</head>
<body>
    <div class="text-right" style="margin-top:20px; margin-bottom:20px">
        <div class="">
            <img  src="data:image/png;base64,{{ img }}" style="max-height : 10%; width : 10%;"/>
        </div>
    </div>
    <h1>{{ title }}</h1>

    <table>
        <thead>
            <tr>
                {% for header in headers %}
                    <th class="{{ header.class ?? 'text-center' }}">{{ header.name }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for item in data %}
                <tr>
                    {% for field in fields %}
                        <td class="{{ field.class ?? 'text-center' }}">{{ obj_attribute(item, field.name) }} {{ field.symbol ?? '' }}</td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>