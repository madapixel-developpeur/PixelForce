{% set FORMATION_STATUS_CREATED = constant('App\\Entity\\Formation::STATUS_CREATED') %}
{% set FORMATION_STATUS_DRAFT = constant('App\\Entity\\Formation::STATUS_DRAFT') %}
{% extends 'base.html.twig' %}
{% block title %}Coach - Liste Formations Video {% endblock %}
{% block body %}
    <div>
        <div class="row mt-4">
            {% if secteur is not null and secteur.id == secteurDigitalId %}
                <div class="col-md-12">
                    <ul class="nav nav-pills mb-4">
                        <!-- account -->
                        <li class="nav-item">
                            <a class="nav-link  {% if section == 'revendeur' %} active bg-princ {% endif %}" href="{{ path('coach_formation_list') }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart font-medium-3 me-50">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2 12h13l2-9H5"></path>
                                </svg>
                                <span class="fw-bold">Formation revendeur</span>
                            </a>
                        </li>
                        <!-- security -->
                        <li class="nav-item">
                            <a class="nav-link {% if section == 'professionnel' %} active bg-princ {% endif %}" href="{{ path('coach_formation_list',{ 'section' : 'professionnel'}) }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-briefcase font-medium-3 me-50">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 7V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v3"></path>
                                </svg>

                                <span class="fw-bold">Formation professionnel</span>
                            </a>
                        </li>
                    </ul>
                </div>
            {% endif %}
            <div class="col-12 col-md-6">
                <h3>Liste des formations</h3>
            </div>
            <div class="col-12 col-md-6 d-flex align-items-center justify-content-end">
                {% if is_granted('ROLE_COACH') %}
                <a href="{{ path('coach_video_formation_add',{ 'section' : section })}}" class="btn bg-info text-white ms-2"><i class="fa fa-plus"></i> Video fin de formation</a>
                <a href="{{ path('coach_formation_add',{ 'section' : section }) }}" class="btn bg-princ text-white ms-2"><i class="fa fa-plus"></i> Ajouter une formation</a>
                <a href="{{ path('coach_quiz_add',{ 'section' : section }) }}" class="btn btn-warning text-white ms-2"><i class="fa fa-plus"></i> Ajouter un quiz</a>
                <a href="{{ path('coach_configure_formation_page' ,{ 'section' : section })}}" class="btn bg-info text-white ms-2"><i class="fa fa-gear"></i> Configurer page de formation</a>
                {% endif %}
            </div>
        </div>

        <form action="" method="get">
            <input type="hidden" name="secteur" value="{{ secteur is not null ? secteur.id : null }}">
            {# <input type="hidden" name="agent" value="{{ agent is not null ? agent.id : null }}"> #}
            <div class="row">
                <div class="col-12 col-md-3 mt-4">
                    <input type="text" name="q[titre]" value="{{ criteres ? criteres.titre }}" class="form-control" placeholder="Titre"/>
                </div>
                <div class="col-12 col-md-3 mt-4">
                    <input type="text" name="q[description]"  value="{{ criteres ? criteres.description }}" class="form-control" placeholder="Déscription"/>
                </div>
                <div class="col-12 col-md-3 mt-4">
                    <input type="text" name="q[auteur]" value="{{ criteres ? criteres.auteur }}" class="form-control" placeholder="Nom de l'auteur"/>
                </div>
                <div class="col-12 col-md-3 mt-4">
                    <select class="form-select" name="q[etat]">
                        <option value="" selected>Etat</option>
                        <option value="">Tous</option>
                        <option value="{{FORMATION_STATUS_CREATED}}" {{ criteres and criteres.etat == FORMATION_STATUS_CREATED ? 'selected' : '' }}>Créée</option>
                        <option value="{{FORMATION_STATUS_DRAFT}}" {{ criteres and criteres.etat == FORMATION_STATUS_DRAFT ? 'selected' : '' }}>Brouillon</option>
                    </select>
                </div>
                <div class="col-12 col-md-4 mt-4">
                    <select class="form-select" name="q[trie]">
                        <option value="titre" selected>Trier par</option>
                        <option value="titre" {{ criteres and criteres.trie == 'titre' ? 'selected' : '' }}>Titre</option>
                        <option value="description" {{ criteres and criteres.trie == 'description' ? 'selected' : '' }}>Description</option>
                        <option value="auteur" {{ criteres and criteres.trie == 'auteur' ? 'selected' : '' }}>Auteur</option>
                        {# <option value="sdf" {{ criteres and criteres.trie == 'sss' ? 'selected' : '' }}>Catégorie</option> #}
                    </select>
                </div>
                <div class="col-12 col-md-4 mt-4">
                    <select class="form-select" name="q[ordre]">
                        <option value="ASC"selected>Ordre</option>
                        <option value="ASC" {{ criteres and criteres.ordre == 'ASC' ? 'selected' : '' }}>ASC</option>
                        <option value="DESC" {{ criteres and criteres.ordre == 'DESC' ? 'selected' : '' }}>DESC</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 mt-4">
                    <select class="form-select" name="q[categorie]">
                        <option value="" selected>Catégorie</option>
                        {% for categorie in categories %}
                            <option value="{{ categorie.nom}}">{{ categorie.nom}}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-1  mt-4">
                    <button class="btn bg-princ text-white"><i class="fa fa-search"></i></button>
                </div>
            </div>
        </form>

        <div>
            {% for categorie in categories %}
                <div class="bg-white border p-4 my-5">
                <div class="d-flex align-items-center justify-content-between">
                    <h1>{{ categorie.nom }}</h1>
                    {% if is_granted('ROLE_COACH') %}
                <a href="{{ path('app_coach_formation_theme_add',{ 'categorieFormationId' : categorie.id })}}" class="btn bg-info text-white ms-2"><i class="fa fa-plus"></i> Ajouter un thème</a>
                    {% endif %}
                    </div>
                    {% set i = 1 %}
                    {% for formation in formations %}
                    
                        {% if formation.categorieFormation ==  categorie and not formation.theme %}
                        {% if i == 1 %}
                        <hr class="my-3" style="height: 3px;">
                        {% else %}
                            <hr class="my-3" style="height: 1px;">
                            {% endif %}
                            {% set i = i + 1 %}
                            {% set isQuiz = formation.type == constant('App\\Entity\\Formation::TYPE_QUIZ') %}
                            <h5 class="{{isQuiz ? 'text-warning': 'text-primary'}}">{{isQuiz ? 'QUIZ: ': ''}} {{ formation.titre }} {% if formation.brouillon %}<small class="text-danger">[ brouillon ]</small>{% endif %}</h5>
                            <div class="row mt-3">
                                <div class="col-12  col-md-10">
                                    <p>{{ formation.description|slice(0, 300) }}</p>
                                </div>
                                <div class="col-12 col-md-2 text-end d-flex align-items-center justify-content-end">
                                {% if is_granted('ROLE_COACH') %}
                                    {% if isQuiz %}
                                    <a href="{{ path('coach_quiz_details', {id:formation.id}) }}" class="btn btn-warning btn-sm"><i class="fa fa-chevron-right"></i> Fiche quiz</a>
                                    <a class="btn btn-warning btn-sm ms-2" href="#" onclick="copyLink('{{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'quiz' ~ '-' ~ formation.id})}}','Lien {{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'quiz' ~ '-' ~ formation.id})}} copié avec succès')"><i class="fa-solid fa-share"></i></a> 
                                    {% else %}
                                    <a href="{{ path('coach_formation_fiche', {id:formation.id}) }}" class="btn btn-primary btn-sm"><i class="fa fa-chevron-right"></i> Fiche formation</a>
                                    <a class="btn btn-warning btn-sm ms-2" href="#" onclick="copyLink('{{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'formation' ~ '-' ~ formation.id})}}','Lien {{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'formation' ~ '-' ~ formation.id})}} copié avec succès')"><i class="fa-solid fa-share"></i></a>
                                    {% endif %}
                                {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                    {% set themes = formationThemeRepository.findBy({'secteur': app.user.uniqueCoachSecteur.id, 'categorieFormation': categorie.id, 'statut': 1}) %}
                    {% for theme in themes %}
                    <hr class="my-3" style="height: 3px;">
                    <div class="d-flex align-items-center justify-content-between">
                    <h4>Thème: {{theme.titre}}</h4>
                    {% set countFormationsTheme = 0 %}
                    {% if is_granted('ROLE_COACH') %}
                  <div class="d-flex align-items-center gap-2 justify-content-end" >
                <a href="{{ path('app_coach_formation_theme_edit',{ 'id' : theme.id })}}" class="btn btn-sm bg-warning text-white ms-2"><i class="fa fa-edit"></i></a>
                    <a href="{{ path('app_coach_formation_theme_delete',{ 'id' : theme.id })}}" class="btn btn-sm bg-danger text-white ms-2"><i class="fa fa-trash"></i></a>
                    </div>  
                    {% endif %}
                    </div>
                    {% for formation in formations %}
                        {% if formation.categorieFormation ==  categorie and formation.theme and formation.theme.id == theme.id %}
                            {% set countFormationsTheme = countFormationsTheme + 1 %}
                            <hr class="my-3" style="height: 1px;">
                            {% set isQuiz = formation.type == constant('App\\Entity\\Formation::TYPE_QUIZ') %}
                            <h5 class="{{isQuiz ? 'text-warning': 'text-primary'}}">{{isQuiz ? 'QUIZ: ': ''}} {{ formation.titre }} {% if formation.brouillon %}<small class="text-danger">[ brouillon ]</small>{% endif %}</h5>
                            <div class="row mt-3">
                                <div class="col-12  col-md-10">
                                    <p>{{ formation.description|slice(0, 300) }}</p>
                                </div>
                                <div class="col-12 col-md-2 text-end d-flex align-items-center justify-content-end">
                                {% if is_granted('ROLE_COACH') %}
                                    {% if isQuiz %}
                                    <a href="{{ path('coach_quiz_details', {id:formation.id}) }}" class="btn btn-warning btn-sm"><i class="fa fa-chevron-right"></i> Fiche quiz</a>
                                    <a class="btn btn-warning btn-sm ms-2" href="#" onclick="copyLink('{{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'quiz' ~ '-' ~ formation.id})}}','Lien {{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'quiz' ~ '-' ~ formation.id})}} copié avec succès')"><i class="fa-solid fa-share"></i></a> 
                                    {% else %}
                                    <a href="{{ path('coach_formation_fiche', {id:formation.id}) }}" class="btn btn-primary btn-sm"><i class="fa fa-chevron-right"></i> Fiche formation</a>
                                    <a class="btn btn-warning btn-sm ms-2" href="#" onclick="copyLink('{{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'formation' ~ '-' ~ formation.id})}}','Lien {{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'formation' ~ '-' ~ formation.id})}} copié avec succès')"><i class="fa-solid fa-share"></i></a>
                                    {% endif %}
                                {% endif %}
                                {# {% if agent %}
                                    {% set statut = agent.formationStatut(formation) %}
                                    {% if statut == constant('App\\Entity\\Formation::STATUT_BLOQUEE') %}
                                        <a href="{{ path('coach_formation_debloquer', {formation : formation.id, agent: agent.id, secteur: secteur.id}) }}" class="btn btn-success mt-2 btn-sm"><i class="fa fa-unlock"></i> Debloquer</a>
                                    {% elseif statut == constant('App\\Entity\\Formation::STATUT_DISPONIBLE') %}
                                        <a href="{{ path('coach_formation_bloquer', {formation : formation.id, agent: agent.id, secteur: secteur.id}) }}" class="btn btn-warning mt-2 btn-sm"><i class="fa fa-lock"></i> Bloquer</a>
                                    {% else %}
                                        <a href="{{ path('coach_formation_createRelation', {formation : formation.id, agent: agent.id, secteur: secteur.id}) }}" class="btn btn-success mt-2 btn-sm"><i class="fa fa-unlock"></i> Debloquer</a>
                                    {% endif %}

                                {% endif %} #}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                    {% if countFormationsTheme == 0 %}
                    <p>Aucune formation pour cet thème</p>
                    {% endif %}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
        {# display navigation #}
        <div class="navigation">
            {# {{ knp_pagination_render(formations) }} #}
        </div>
    </div>
{% endblock %}