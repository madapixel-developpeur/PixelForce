{% extends 'base.html.twig' %}
{% block title %}
    {% trans %}Coach - Fiche formation{% endtrans %}
{% endblock %}
{% block body %}
    <!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">{% trans %}Confirmation{% endtrans %}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        {% trans %}Voulez-vous vraiment supprimer la formation ?{% endtrans %}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">{% trans %}Fermer{% endtrans %}</button>
        <a role="button" href="{{path('coach_formation_delete', {'id': formation.id})}}" class="btn btn-danger text-white mx-2" >
            {% trans %}Valider{% endtrans %}
        </a>
      </div>
    </div>
  </div>
</div>
    <div class="p-5 pb-5 mb-5 bg-white border position-relative" id="form-formation">
        <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class=""><i class="fa fa-book-open"></i> {% trans %}Fiche formation{% endtrans %}</h3>
                    <a class="text-dark-template fs-5" href="#" onclick="copyLink('{{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'formation' ~ '-' ~ formation.id})}}','Lien {{url('app_agent_view_share', { 'shareKey': 'secteur' ~ '-' ~ app.user.uniqueCoachSecteur.id ~ '-' ~ 'formation' ~ '-' ~ formation.id})}} copié avec succès')"><i class="fa-solid fa-share"></i></a>
                    </div>
        
        {{ form_start(form, {
            'attr': {
                'id': 'formation-fiche',
                'action': path('coach_formation_fiche', {id: formation.id}),
                'enctype': 'multipart/form-data'  
            }
        }) }}

        <input type="hidden" id="inputVideo" class="hiddenVideoData">
        <div class="row">
            <div class="col-12 col-md-8">
                {{ form_row(form.titre, {label_attr: {
                    class:'fw-bold'
                }}) }}
                {{ form_row(form.description, {attr:{rows:10}, label_attr: {class:'fw-bold'}}) }}
                {# {{ form_row(form.description_deblocage, {attr:{rows:10}, label_attr: {class:'fw-bold'}}) }} #}
                {{ form_row(form.contenu, {attr:{rows:20}, label_attr: {class:'fw-bold'}}) }}
                
                <h5 class="fw-bolder">{% trans %}Catégorie{% endtrans %}</h5>
                {{ form_row(form.categorieFormation ) }}
                {{ form_row(form.theme, {label_attr: {
                    class:'fw-bold'
                }} ) }}
                <div class="bg-light-info text-dark p-4 border">
                    <div class="border-bottom border-2  border-bottom-black">
                        <strong>{% trans %}Informations{% endtrans %}</strong>
                    </div>
                    <div class="row mt-4">
                        <div class="col-12 col-md-6">
                            <strong>{% trans %}Etat{% endtrans %}</strong> : {{ formation.brouillon ? 'Brouillon' : 'Créée' }} <br>
                            <strong>{% trans %}Catégorie{% endtrans %}</strong> : {{ formation.categorieFormation ? formation.categorieFormation.nom : ''  }}
                            <hr>
                            {{ form_row(form.brouillon) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {# <strong>Disponibilité</strong> : {{ formation.debloqueAgent ? 'Disponible pour tous les agents' : 'Bloquer pour tous les agents' }}
                            
                            {{ form_row(form.debloqueAgent) }} #}
                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div>
                    <div class="fw-bold text-decoration-underline mb-3">
                       {% trans %}Videos{% endtrans %}
                    </div>
                    <div class="border p-0 d-flex bg-black">
                        <iframe src="https://player.vimeo.com/video/{{ formation.videoId }}" style="width:100%; height:400px" class="m-auto" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>
                    </div>
                    <div class="my-3" id="formation-video">
                        {# <button class="btn btn-primary btn-sm" id="btn-add-video"><i class="fa fa-plus"></i> Ajouter une nouvelle video</button> #}
                        <br/>
                        {# <input type="checkbox" id="check_url" onchange="toggleInputUrl(event)" checked/> #}
                        <span>{% trans %}Modifier le lien de la video{% endtrans %}</span>
                        <input type="text" class="form-control" id="input-url-video" placeholder="Veuillez collez ici l'url de la video (Vimeo)" />
                        <div>
                            <span id="video-upload-name" class="badge bg-light-info text-dark mt-2 d-none"><i class="fa-solid fa-video me-2"></i></span>
                        </div>
                        <div>
                            <span id="loading-video-container" class=" d-none">{% trans %}Loading{% endtrans %} : <span id="loading-video"></span>%</span>
                        </div>
                        <div>
                            <video id="video-upload-preview" width="300" height="200" class="mt-2 d-none bg-dark"  controls></video>
                        </div>

                    </div>
                    <div class="fw-bold text-decoration-underline mb-3">
                        {% trans %}Fichiers joints{% endtrans %}
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <strong>{% trans %}Document{% endtrans %}</strong>
                            {% if medias.count > 0 %}
                                {% for media in medias %}
                                    {% if media.type == 'document' %}
                                        <div class="row media">
                                            <div class="col-12 col-md-9 mt-4 font-small-2 ">
                                                <span><i class="fa-solid {{ media.type == 'document' ? 'fa-book' : 'fa-music' }} me-2"></i> {{ media.titre}}</span>
                                            </div>
                                            <div class="col-12 col-md-3 mt-4 font-small-1">
                                                <a href="#" class="btn btn-outline-danger btn-sm btn-media-delete" data-media-id="{{ media.id }}"><i class="fa fa-trash"></i></a>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <div class="col-12">
                                    <strong class="text-danger">{% trans %}Pas de document{% endtrans %}</strong>
                                </div>
                            {% endif %}
                            <div class="my-3" id="formation-document">
                                <button class="btn btn-primary btn-sm btn-add" id="btn-add-document"><i class="fa fa-plus"></i> {% trans %}Ajouter un document{% endtrans %}</button>
                                <div id="document-upload-name" class="mt-3"></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>{% trans %}Audio{% endtrans %}</strong>
                            {% if medias.count > 0 %}
                                {% for media in medias %}
                                    {% if media.type == 'audio' %}
                                        <div class="row media">
                                            <div class="col-12 col-md-9 mt-4 font-small-2 ">
                                                <span><i class="fa-solid {{ media.type == 'document' ? 'fa-book' : 'fa-music' }} me-2"></i> {{ media.titre}}</span>
                                                <br />
                                                <audio controls style="width: 200px; height: 30px;">
                                                    <source src="{{ path('media_download', {id:media.id}) }}" />
                                                </audio>
                                            </div>
                                            <div class="col-12 col-md-3 mt-4 font-small-1">
                                                <a href="#" class="btn btn-outline-danger btn-sm btn-media-delete" data-media-id="{{ media.id }}"><i class="fa fa-trash"></i></a>
                                                
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <div class="col-12">
                                    <strong class="text-danger">{% trans %}Pas d'audio{% endtrans %}</strong>
                                </div>
                            {% endif %}
                            <div class="my-3" id="formation-audio">
                                <button class="btn btn-primary btn-sm btn-add" id="btn-add-audio"><i class="fa fa-plus"></i> {% trans %}Ajouter un audio{% endtrans %}</button>
                                <div id="audio-upload-name" class="mt-3"></div>
                            </div>
                        </div>
                    </div>
                    <div class="media-container">
                    </div>
                    <input type="hidden" name="video_id" id='video_id'>
                </div>
            </div>
        </div>
        <div class="mt-4 d-flex align-items-center justify-content-start">
            <button type="submit" id="edit-formation" class="btn bg-princ text-white">{% trans %}Enregistrer{% endtrans %}</button>
            
            <button type="button" class="btn btn-danger text-white mx-2" data-toggle="modal" data-target="#deleteModal">
                {% trans %}Supprimer{% endtrans %}
            </button>
        </div>


        {{ form_end(form) }}
    </div>


{% endblock %}
{% block javascripts %}
    {{ parent() }}
    
    {# {{ encore_entry_script_tags('formationForm')}} #}
    {{ encore_entry_script_tags('formationFormScript')}}
    {# {{ encore_entry_script_tags('ckeditorForm')}} #}
    <script>
        function toggleInputUrl(e)
        {
            if(e.target.checked) {
                $('#input-url-video').removeAttr('disabled');
                $('#btn-add-video').attr('disabled','disabled');
            } else {
                $('#input-url-video').attr('disabled','disabled');
                $('#btn-add-video').removeAttr('disabled');
            }
        }

        $(document).ready(function () {
            let $categorieSelect = $("#{{ form.categorieFormation.vars.id }}");
            let $themeSelect = $("#{{ form.theme.vars.id }}");
            let themeOptions = {{ themes | json_encode() | raw()}}; // Store all theme options
             let formationThemeId = {% if formation and formation.theme %}{{formation.theme.id}}{% else %}undefined{% endif %};
            function updateThemeOptions(first = false) {
                let selectedCategorie = $categorieSelect.val();
               
                if (selectedCategorie) {
                    console.log(themeOptions)
                    const tos = themeOptions.filter((to) => to.categorieFormationId == selectedCategorie);
                    $themeSelect.html('');
                    $themeSelect.append('<option value="">--</option>');
                    for(const to of tos) {
                        
                        $themeSelect.append(`<option value="${to.id}" ${(first && formationThemeId == to.id) ? 'selected':''}>${to.titre}</option>`)
                    }
                    
                } else {
                    
                    $themeSelect.html('');
                    $themeSelect.append('<option value="">--</option>');
                }

                
            }

            $categorieSelect.on("change", function () {
                console.log('here')
                updateThemeOptions();
            });
            updateThemeOptions(true); // Initialize on page load
        });
    </script>
{% endblock %}
