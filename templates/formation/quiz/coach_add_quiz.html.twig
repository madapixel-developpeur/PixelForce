{% extends 'base.html.twig' %}

{% block title %} Quiz {% endblock %}

{% block stylesheets %}
    {{ parent() }}
	<style>
		
	</style>
{% endblock %}

{% block body %}
	<div class="container my-5">
		<div class="content-body-form">
			<div class="row">
				<div class="col-sm-0 col-md-3"></div>
				<div class="col-sm-12 col-md-6">
						<h1 class="fw-bolder text-center mb-5">Quiz </h1>
						{{ form_start(form) }}
						<div class="row">
							
							<div class="col-12">
								<div class="mb-3">
									{{form_label(form.titre)}}
									{{form_widget(form.titre,{ 'attr': {'class': 'form-control'} })}}
									{{form_errors(form.titre)}}
								</div>
								<div class="mb-3">
									{{form_label(form.description)}}
									{{form_widget(form.description)}}
									{{form_errors(form.description)}}
								</div>
								<div class="mb-3">
									{{form_label(form.CategorieFormation)}}
									{{form_widget(form.CategorieFormation)}}
									{{form_errors(form.CategorieFormation)}}
								</div>
								<div class="mb-3">
									{{form_label(form.theme)}}
									{{form_widget(form.theme)}}
									{{form_errors(form.theme)}}
								</div>
						
							</div>
						</div>
						<div class="row">
							<div class="col-md-12 text-end"><button class="btn btn-success my-4" type="submit">Enregistrer</button></div>
						</div>					
						{{ form_end(form) }}
					</div>
				<div class="col-sm-0 col-md-3"></div>
			</div>

            
			
        </div>
	</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
	<script>
		$(document).ready(function () {
            let $categorieSelect = $("#{{ form.CategorieFormation.vars.id }}");
            let $themeSelect = $("#{{ form.theme.vars.id }}");
            let themeOptions = {{ themes | json_encode() | raw()}}; // Store all theme options
			let formationThemeId = {% if formation and formation.theme %}{{formation.theme.id}}{% else %}undefined{% endif %};
            console.log(themeOptions)
            function updateThemeOptions(first = false) {
                let selectedCategorie = $categorieSelect.val();

                if (selectedCategorie) {
                    console.log(themeOptions)
                    const tos = themeOptions.filter((to) => to.categorieFormationId == selectedCategorie);
                    $themeSelect.html('');
                    $themeSelect.append('<option value="">--</option>');
                    for(const to of tos) {
                        
                        $themeSelect.append(`<option value="${to.id}" ${(first && formationThemeId == to.id) ? 'selected':''}>${to.titre}</option>`)
                    }
                    
                } else {
                    
                    $themeSelect.html('');
                    $themeSelect.append('<option value="">--</option>');
                }

                
            }

            $categorieSelect.on("change", function () {updateThemeOptions();});
            updateThemeOptions(true); // Initialize on page load
        });
	</script>
{% endblock %}