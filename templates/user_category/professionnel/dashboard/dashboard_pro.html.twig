{% extends 'base.html.twig' %}


{% block title %}
	Dashboard : {{ secteur.nom }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('vuexy_dashboard_ecommerce') }}
    <link rel="stylesheet" href="{{asset('assets/css/stepper.css')}}">
    <link rel="stylesheet" href="{{asset('assets/css/dashboard-custom-style.css?v=202502260951')}}">
{% endblock %}

{% block body %}
    <div class="mt-3">
        <section id="dashboard-ecommerce">
            <div class="row">
                <div  class="col-md-12" >
                    <div id="carouselExampleControls" class="carousel slide custom-carousel" data-ride="carousel"  >
                        <div class="carousel-inner rounded-3" style="min-height: 320px;background-color:white">
                            {% for announcement in announcements %}
                                <div class="carousel-item {% if loop.first %}active{% endif %} ">
                                    <img class="d-block w-100 rounded-3 border" style="height: 320px" src="{{ asset('files/') ~ announcement.filePath }}" alt="{{ announcement.nom }}">
                                </div>
                            {% endfor %}
                        </div>
                        <a class="carousel-control-prev custom-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="sr-only">Previous</span>
                        </a>
                        <a class="carousel-control-next custom-next" href="#carouselExampleControls" role="button" data-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="sr-only">Next</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="row match-height mt-4">
                <div class="col-md-12">
                    <h4 class=" mt-2 mb-3 choix-secteur-primary">Réseaux sociaux</h4>
                    <div class="row carousel-container carousel-service "> 
                        <div id="secteurCarousel" class="carousel carousel-dark slide mt-3" data-ride="carousel">
                            <div class="carousel-inner">
                            {% for chunk in socialMedias %}
                                <div class="carousel-item {% if loop.first %} active{% endif %} ">
                                    <div class="row ">
                                        {% for item in chunk %}
                                            <div class="col-md-3 d-flex ">
                                                <div class="bd-services-2__item text-center mb-30 wow fadeInUp card d-flex flex-column w-100">
                                                    <h3 class="bd-services-2__title"><a href="{{ item.link }}" target="_blank">{{ item.name }}</a></h3>
                                                    <div class="d-flex flex-column flex-grow-1">
                                                        <div class=" text-center logo-container  mt-auto">
                                                            <img src="{{asset( files_directory_relative ~ item.logo )}}" alt="{{ item.name }}" class="social-media-logo">
                                                        </div>
                                                    </div>
                                                    <div class="bd-services-2__content">
                                                        <p class="bd-services-2__description">
                                                            {# Lorem ipsum dolor sit amet consectetur adipisicing elit. Amet dolorem earum, eum sint dicta optio! Accusantium quaerat vel voluptatem, autem placeat iure labore dolorem. Dolorum veniam amet expedita dolore similique. #}
                                                        </p>

                                                    </div>
                                                    <div class="bd-services-2__item-btn mt-auto">
                                                        <a href="{{ item.link }}" class="btn btn-primary" target="_blank">
                                                            Rejoindre <i class="fas fa-chevron-right"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                            </div>
                            <a class="carousel-control-prev" href="#secteurCarousel" role="button" data-slide="prev">
                                <span class="fs-1" aria-hidden="true"><i class="fa fa-angle-left color-pixelforce" aria-hidden="true"></i></span>
                                <span class="sr-only">Previous</span>
                            </a>
                            <a class="carousel-control-next" href="#secteurCarousel" role="button" data-slide="next">
                                <span class="fs-1" aria-hidden="true"><i class="fa fa-angle-right color-pixelforce" aria-hidden="true"></i></span>
                                <span class="sr-only">Next</span>
                            </a>
                        </div>
                    </div>
                </div> 
            </div>
         </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

{% endblock %}