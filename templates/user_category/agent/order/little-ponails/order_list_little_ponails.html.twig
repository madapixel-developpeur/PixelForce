					</div>

				{% endif %}
				{% if orderList|length !=0 %}
					<div class="table-responsive">
						<table class="table text-center">
							<tbody class="align-items-center">
								<tr>
									<th>{% trans %}Créée le{% endtrans %}</th>
									<th>{% trans %}Nom d'utilisateur{% endtrans %}</th>
									<th>{% trans %}Total{% endtrans %}</th>
									<th>{% trans %}Statut{% endtrans %}</th>
									<th></th>
								</tr>

								{% for order in orderList %}
									<tr>
										<td>{{order.date_created | date("d/m/Y H:i")}}</td>
										<td>{{order.username }}
										</td>
										<td>{{order.net_total | number_format(2, ',', ' ')}}
											€</td>
										<td>{{get_lpn_command_status_meaning(order.status) }}</td>
										<td class="col-action ">
											<a href="{{ path('app_view_order_lpn',{ 'ref' : order.order_id  })}}">
												<i data-feather="eye"></i>
											</a>
										</td>
									</tr>
								{% endfor %}

							</tbody>
						</table>
