{% extends 'base.html.twig' %}

{% block title %}
	Commandes
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% block body %}
	{% if app.session.get('secteurId') == secteurDigitalId %}
		<div class="row mb-3">
			<div class="col-12  mt-2 mt-md-3">
				<h4 class="my-auto general-primary-text">Statistiques</h4>
			</div>
		</div>
		<div class="row px-3 rounded-3">
			<div class="card card-statistics rounde mb-3">
				<div class="card-body ">
					<div class="row mb-3">
						<div class="col-xl-6 col-sm-12 col-12 m-2 m-xl-0">
							<div class="d-flex flex-row m-2">
								<div class="rounded-circle bg-light-secondary me-2 detail-agent-equipe">
									<div class="text-center">
										<a href="#">
											<i class="fa fa-dollar fs-4 pt-3"></i>
										</a>
									</div>
								</div>
								<div class="my-auto">
									<a href="#">
										<p class="card-text font-small-3 mb-0 text-black">MES VENTES PERSONNELLES</p>
									</a>
									<h4 class="fw-bolder mb-0">{{ statCa.ca_perso | number_format(2, ',', ' ')  }} €</h4>
								</div>
							</div>
						</div>
						<div class="col-xl-6 col-sm-12 col-12 mb-2 mb-xl-0 border-start border-3">
							<div class="d-flex justify-content-start align-items-center m-2">
								<div class="rounded-circle bg-light-secondary me-2 detail-agent-equipe">
									<div class="text-center">
										<a href="#">
											<i class="fa fa-users fs-4 pt-3"></i>
										</a>
									</div>
								</div>
								<div class="my-auto">
									<a href="#">
										<p class="card-text font-small-3 mb-0 text-black">MES VENTES EQUIPES</p>
									</a>
									<h4 class="fw-bolder mb-0">{{ statCa.ca_equipe | number_format(2, ',', ' ')  }} €</h4>
								</div>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-xl-6 col-sm-12 col-12 m-2 m-xl-0">
							<div class="d-flex flex-row m-2">
								<div class="rounded-circle bg-light-secondary me-2 detail-agent-equipe">
									<div class="text-center">
										<a href="#">
											<i class="fa fa-coins fs-4 pt-3"></i>
										</a>
									</div>
								</div>
								<div class="my-auto">
									<a href="#">
										<p class="card-text font-small-3 mb-0 text-black">Mes gains</p>
									</a>
									<h4 class="fw-bolder mb-0">{{ statCa.gain | number_format(2, ',', ' ')  }} € </h4>
								</div>
							</div>
						</div>
						<div class="col-xl-6 col-sm-12 col-12 mb-2 mb-xl-0 border-start border-3">
							<div class="d-flex justify-content-start align-items-center m-2">
								<div class="rounded-circle bg-light-secondary me-2 detail-agent-equipe">
									<div class="text-center">
										<a href="#">
											<i class="fa fa-chart-pie fs-4 pt-3" aria-hidden="true"></i>
										</a>
									</div>
								</div>
								<div class="my-auto">
									<a href="#">
										<p class="card-text font-small-3 mb-0 text-black">Mon CA</p>
									</a>
									<h4 class="fw-bolder mb-0">{{ statCa.ca_global | number_format(2, ',', ' ')  }}  €</h4>
								</div>
							</div>
						</div>


					</div>
				</div>
			</div>
		</div>
	{% endif %}

	<div class="row mb-3">
		<div class="col-12  mt-2 mt-md-3">
			<h4 class="my-auto general-primary-text">Liste des commandes</h4>
		</div>
	</div>
	<div class="card card-company-table p-5 rounded-3" style="">
		<div class="card-body p-0">
			<div class="card-head mb-3">
				<div class="row">
					<div class="col-0 col-md-6"></div>
					<div class="col-12 col-md-6 d-flex justify-content-center">
						<form action="" class="input-group rounded-3 m-2 w-75">
							<button class="input-group-text border-0" id="search-addon" type="submit">
								<i class="fas fa-search"></i>
							</button>
							<input type="search" name="search" class="form-control  input-group-text border-0" placeholder="Chercher" aria-label="Search" aria-describedby="search-addon"/>
						</form>
						<div class="col-6 col-md-4">
							<div class="input-group rounded-3 m-2">
								<button class="input-group-text border-0 w-100" type="button" data-toggle="collapse" data-target="#filters" aria-expanded="false" aria-controls="filters">
									<span class="input-group-text border-0 w-25 rounded-4 me-4" id="filter-toggle">
										<i class="fa-solid fa-bars-staggered"></i>
									</span>
									Filtres
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
			{{ form_start(form, {'attr': { 'id': 'product-filter-form'}}) }}
			<div class="collapse" id="filters">
				<div class="block block--bordered block--rounded">
					<h1 class="block__text block__text--center mt-2">Options de filtre :</h1>
					<div
						class="filter-wrap">
						<!-- Formulaire de recherche -->
						<div class="search-form">
							<div class="filter-form">
								<div class="col-12 col-md-3">
									{{form_label(form.status)}}
									{{form_widget(form.status)}}
									{{form_errors(form.status)}}
								</div>
								<div class="col-12 col-md-2">
									{{form_label(form.dateMin)}}
									{{form_widget(form.dateMin)}}
									{{form_errors(form.dateMin)}}
								</div>
								<div class="col-12 col-md-2">
									{{form_label(form.dateMax)}}
									{{form_widget(form.dateMax)}}
									{{form_errors(form.dateMax)}}
								</div>
								<div class="col-12 col-md-2">
									{{form_label(form.clientName)}}
									{{form_widget(form.clientName)}}
									{{form_errors(form.clientName)}}
								</div>
								<div class="col-12  col-md-2">
									{{form_label(form.referenceVente)}}
									{{form_widget(form.referenceVente)}}
									{{form_errors(form.referenceVente)}}
								</div>

								<div class="btn-wrap">
									<button class="btn btn-primary" type="submit" name="action_button" value="search_action">
										<i data-feather="filter"></i>Filtrer</button>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
			<div class="row w-100">
				<div class="col-12 col-md-12 mt-3 d-flex align-items-center justify-content-start p-0 mb-3 ">
					<button name="action_button" value="excel" class=" mt-2 btn btn-success btn-sm me-2 rounded-3">
						<i class="fa fa-print"></i>
						<span class="ms-1">Exporter excel</span>
					</button>
					<button name="action_button" value="csv" class=" mt-2 btn btn-success btn-sm me-2 rounded-3">
						<i class="fa fa-print"></i>
						<span class="ms-1">Exporter csv</span>
					</button>
					<button name="action_button" value="pdf" class=" mt-2  btn btn-danger btn-sm me-2 rounded-3">
						<i class="fa fa-file-text"></i>
						<span class="ms-1">Exporter pdf</span>
					</button>
				</div>
			</div>
			{{ form_end(form) }}


			{% if orderList|length ==0 %}
				<div class="alert alert-primary p-3 text-center" role="alert">
					<div class="alert-body">
						Aucune Commande
					</div>
				</div>
			{% endif %}
			{% if orderList|length !=0 %}
				<div class="table-responsive">
					<table class="table text-center">
						<tbody class="align-items-center">
							<tr>
								<th>Date</th>
								<th>Client</th>
								<th>Pack - (service)</th>
								<th>Montant</th>
								<th>Référence</th>
								<th>Statut</th>
								<th></th>
							</tr>

							{% for order in orderList %}
								<tr>
									<td>{{order.createdAt | date("d/m/Y H:i")}}</td>
									<td>{{order.infoClient.firstName}}
										{{order.infoClient.lastName}}</td>
									<td>{{order.package.name}}
										- ({{order.package.service}})</td>
									<td class="text-right">{{order.amount | number_format(2, ',', ' ') }}</td>
									<td>
										<a href="{{ path('agent_order_list_digital',{'referenceVente' : order.infoClient.referenceVente }) }}">{{order.infoClient.referenceVente}}</a>
										{# <a class="p-2" href="#" onclick="copyLink('{{ url('agent_order_list_digital',{'referenceVente' : order.infoClient.referenceVente }) }}','Liens de la référence {{  order.infoClient.referenceVente }} copié avec succès') "><i class="fa-solid fa-copy"></i></a>  #}
									</td>
									<td>{{order.statusStr}}</td>
									<td class="col-action ">
										<a href="{{path('agent_order_details_digital', {'id': order.id})}}">
											<i data-feather="eye"></i>
										</a>
									</td>
								</tr>
							{% endfor %}

						</tbody>
					</table>
				</div>
				<div class="pagination d-flex justify-content-center">
					{{ knp_pagination_render(orderList)}}
				</div>
			{% endif %}
		</div>
	</div>

{% endblock %}
