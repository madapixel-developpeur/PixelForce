{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Chiffre d'affaires - Détail{% endtrans %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <a href="{{ path('app_common_ca_list') }}" class="btn btn-secondary mb-2 mt-3"> <i class="fa-solid fa-circle-arrow-left"></i> {% trans %}Retour{% endtrans %} </a>
    <div class="card card-company-table p-5 rounded-3" style="">
		<div class="card-body p-0">
            <div class="row">
                <div class="col-md-12">
                    <h1 class="block__title mb-4">{% trans %}Vente du mois de{% endtrans %} "{{ month  }}" :</h1>
                    <p><b>{% trans %}Position de l'égerie du mois{% endtrans %}:</b>{{ caDetail.position ? caDetail.position.name : "Little égerie"}}</p>
                    <p><b>{% trans %}Achats perso{% endtrans %}:</b> {{caDetail.own_sales | number_format(2, ',', ' ') }} € ({{ caDetail.own_num_items_sold }} {% trans %}articles{% endtrans %})</p>
                    <p><b>{% trans %}Achats clients{% endtrans %}:</b> {{caDetail.sponsored_sales | number_format(2, ',', ' ') }} € ({{caDetail.own_num_items_sold}} transarticles)</p>
                    <p><b>{% trans %}Chiffre d'affaire personnel (Achats perso + achats clients){% endtrans %}:</b> {{caDetail.total_sales | number_format(2, ',', ' ') }} € ({{caDetail.num_items_sold}} {% trans %}articles{% endtrans %})</p>
                    <p><b>{% trans %}Chiffre d'affaire équipe{% endtrans %}:</b> {{ caDetail.ca_team | number_format(2, ',', ' ')  }} €</p>
                    <p><b>{% trans %}Chiffre d'affaire global (CA Perso + CA Equipe){% endtrans %}:</b> {{ caDetail.ca_global | number_format(2, ',', ' ')   }} €</p>
                    <p><b>{% trans %}Commissions sur achats clients{% endtrans %}:</b> {{ caDetail.commission_sponsored_sales  | number_format(2, ',', ' ')  }} €</p>
                    <p><b>{% trans %}Commissions sur chiffre d'affaire équipe{% endtrans %}:</b> {{  caDetail.commission_ca_team | number_format(2, ',', ' ')  }} €</p>
                </div>
            </div>
        </div>
    </div>

{% endblock %}


