{% extends 'base.html.twig' %}

{% block title %}
	Ressource
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %} 
    <div class="block block--bordered block--rounded">
        <h1 class="block__text block__text--center mt-2" >Options de filtre :</h1>
        <div class="filter-wrap">
            
            {{ form_start(form, {'attr': {'class': 'filter-form'}}) }}
                
                <div class="my-form-widget">
                    {{form_label(form.name)}}
                    {{form_widget(form.name)}}
                    {{form_errors(form.name)}}
                </div>
                
                
                <div class="my-form-widget">
                    {{form_label(form.sort)}}
                    {{form_widget(form.sort)}}
                    {{form_errors(form.sort)}}
                </div>
                <div class="my-form-widget">
                    {{form_label(form.direction)}}
                    {{form_widget(form.direction)}}
                    {{form_errors(form.direction)}}
                </div>
                <div class="btn-wrap">
                    <button class="btn btn-primary" type="submit"><i data-feather="filter"></i>Filtrer</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
    <div class="block block--bordered block--rounded">
        {% for label, message in app.flashes %}
            <div class="alert alert-{{label}} p-3 text-center" role="alert">
                <div class="alert-body">
                    {{message}}
                </div>
            </div>
        {% endfor %}
        <div class="block__header mb-1" >
            <h1 class="block__title">Liste des ressources :</h1>
            
        </div>
        {% if result|length ==0 %}
                <div class="alert alert-primary p-3 text-center" role="alert">
                    <div class="alert-body">
                        Aucun résultat.
                    </div>
                </div>
        {% endif %}
        {% if result|length > 0 %}
        <div class="row">
        {% for item in result %}
            <div class="card col-md-4">
            {% if item.imageCover %}
                <img class="card-img-top" src="{{ asset( files_directory_relative ~ item.imageCover) }}" alt="Card image cap">
            {% endif %}
                <div class="card-body">
                    <h5 class="card-title">{{item.name}}</h5>
                    {% if item.content and item.content != '' %}
                    <p class="card-text">{{item.content}}</p>
                    {% endif %}
                    {% if item.files|length > 0 %}
                    <div class="mt-3">
                        <div class="d-flex flex-column" >
                        <div class="d-flex align-items-start flex-wrap ms-2" style="gap: 5px;">
                            {% for file in item.filesParsed %}
                            <div class="file-block" >
                                <span><i class="fa-regular fa-file fa-lg"></i></i>&nbsp;{{file.customName}}</span>
                                <div class="file-close download-file" style="cursor: pointer" data-path="{{file.path}}"><i class="fa-solid fa-download fa-lg"></i></div>
                            </div>
                            {% endfor %}
                        </div>
                        </div >
                    </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
        </div>
        <div class="d-flex justify-content-center scale-up-center mt-2">
            {{ knp_pagination_render(result) }}
        </div>
