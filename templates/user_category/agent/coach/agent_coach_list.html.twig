{% extends 'base.html.twig' %}

{% block title %}
    {% trans %}Liste des coachs{% endtrans %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}

     <div class="row mb-3">
		<div class="col-12  mt-2 mt-md-3">
			<h4 class="my-auto general-primary-text">{% trans %}Liste des coachs{% endtrans %}</h4>
		</div>
	</div>
	<div class="card card-company-table p-5 rounded-3" style="">
				<div class="card-body p-0">
					<div class="card-head mb-3">
                        <div class="row">
                            <div class="col-0 col-md-6"></div>
                            <div class="col-12 col-md-6 row">
                                <div class="col-6 col-md-8">
                                    <form action="{{ path('agent_coach_list') }}" class="input-group rounded-3 m-2 w-100 w-sm-75">
                                        <button class="input-group-text border-0" id="search-addon" type="submit">
                                            <i class="fas fa-search"></i>
                                        </button>
                                        <input type="search" name="search" class="form-control input-group-text border-0" placeholder="Chercher" aria-label="Search" aria-describedby="search-addon" />
                                    </form>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="input-group rounded-3 m-2">
                                        <button class="input-group-text border-0 w-100" type="button" data-toggle="collapse" data-target="#filters" aria-expanded="false" aria-controls="filters">
                                            <span class="input-group-text border-0 w-25 rounded-4 me-4" id="filter-toggle">
                                                <i class="fa-solid fa-bars-staggered"></i>
                                            </span>
                                            {% trans %}Filtres{% endtrans %}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{ form_start(searchForm) }}
                    <div class="collapse" id="filters">
                        <div class="block block--bordered block--rounded">
                            <h1 class="block__text block__text--center mt-2">{% trans %}Options de filtre{% endtrans %} :</h1>
                            <div class="filter-wrap">
                                <!-- Formulaire de recherche -->
                                <div class="search-form">
                                    <div class="row text-center">
                                        <div class="col-12 col-sm-6 col-md-4">
                                            {{ form_row(searchForm.prenom) }}
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4">
                                            {{ form_row(searchForm.email) }}
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4">
                                            {{ form_row(searchForm.telephone) }}
                                        </div>
                                        <div class="col-12 col-sm-12 col-md-12 mt-3 d-flex">
                                            <button class="btn btn-primary"  name="action_button" value="search_action" ><i class="fa-solid fa-magnifying-glass"></i> {% trans %}Rechercher{% endtrans %}</button>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-12 mt-3 d-flex align-items-center justify-content-start p-0 mb-3 ">
                            <button name="action_button" value="excel"  class=" mt-2 btn btn-success btn-sm me-2 rounded-3"><i class="fa fa-print"></i> <span class="ms-1">{% trans %}Exporter excel{% endtrans %}</span></button>
                            <button name="action_button" value="csv"  class=" mt-2 btn btn-success btn-sm me-2 rounded-3"><i class="fa fa-print"></i> <span class="ms-1">{% trans %}Exporter csv{% endtrans %}</span></button>
                            <button name="action_button" value="pdf"  class=" mt-2  btn btn-danger btn-sm me-2 rounded-3"><i class="fa fa-file-text"></i> <span class="ms-1">{% trans %}Exporter pdf{% endtrans %}</span></button>
                        </div>
                    </div>
                    {{ form_end(searchForm) }}

                    
                    {% if coachs|length ==0 %}
                        <div class="alert alert-primary p-3 text-center" role="alert">
                            <div class="alert-body">
                                {% trans %}Aucun Coach trouvé{% endtrans %}
                            </div>
                        </div>
                    {% endif %}
                    {% if coachs|length !=0 %}
					<div class="table-responsive">
						<table class="table text-center">
							<tbody class="align-items-center">
								<tr>
                                        <th scope="col">#</th>
                                        <th scope="col">{% trans %}Photo{% endtrans %}</th>
                                        <th scope="col">{% trans %}Nom et prénoms{% endtrans %}</th>
                                        <th scope="col">{% trans %}Email{% endtrans %}</th>
                                        <th scope="col">{% trans %}Téléphone{% endtrans %}</th>
                                        <th scope="col">{% trans %}Secteur{% endtrans %}</th>
                                        <th scope="col">{% trans %}ACTION{% endtrans %}</th>
                                </tr>
								{% for coach in coachs %}
                                            {% set secteurs = repoCoachSecteur.findBy({'coach' : coach}) %}
                                            {% set modal_id = "modal" ~ coach.id %}
                                            
                                            {{include ('partials/modalDedailCoach.html.twig',{coach:coach,secteur:secteurs[0].getSecteur()}) }}

                                            <tr class="align-items-center">
                                                <td>{{ coach.id }}</td>
                                                <td >
                                                    <div class="d-flex align-items-center justify-content-center" type="button" class="btn btn-primary" data-toggle="modal" data-target="#{{modal_id}}">
                                                        <div class="img">
                                                            <img src="{{ path('user_avatar', {id:coach.id}) }}" class="w-50 rounded-3" alt="">
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-dark-template " ype="button" class="btn btn-primary" data-toggle="modal" data-target="#{{modal_id}}">{{ coach.fullName }}</td>
                                                <td ><a class="text-tableau" href= "mailto: {{ coach.email }}"> {{ coach.email }} </a></td>
                                                <td ><a class="text-tableau" href="tel:{{ coach.telephone|default('-') }}">{{ coach.telephone|default('-') }}</a></td>
                                                 <td>
                                                    {# On récupère les secteurs reliés par l'agent  #}
                                                    <span class="badge bg-light-warning ">{{ coach.allSecteursOfUser(secteurs)|default('-') }}</span>     
                                                </td>
                                                <td>
                                                    <a class="regular-button text-center rounded-3"  href="#" onclick="Calendly.initPopupWidget({url: '{{coach.getLienCalendly()}}'});return false;" style="min-width:140px;">{% trans %}Prendre RDV{% endtrans %} </a>
                                                </td>    
                                            </tr>
                      
                                    {% else %}
                                        <tr>
                                            <td class="text-center" colspan="5">{% trans %}Aucun Coach trouvé{% endtrans %}</td>
                                        </tr>
                                    {% endfor %}
							</tbody>
						</table>
					</div>
                    <div class="pagination d-flex justify-content-center">
                            {{ knp_pagination_render(coachs)}}
                    </div>
                     {% endif %}
				</div>
	</div
{% endblock %}
