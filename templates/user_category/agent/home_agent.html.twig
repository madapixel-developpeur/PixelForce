{% extends 'base-choix.html.twig' %}

{% block title %}
	{% trans %}Choix du secteur{% endtrans %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{asset('app-assets/css/pages/app-home-agent.css')}}">
    <link  rel="stylesheet"   href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <style>
        .btn-primary {
        border-color: #7367f0 !important;
        /*background-color: #7367f0 !important;*/
        background-color: #3e4f9c !important;
        color: #fff !important; }

    </style>
{% endblock %}

{% block body %}
    {% set stripe_defaultButton =  "S'abonner (" ~ planPrice ~ " €)" %}

    <div class="container-page">
        <h1 class="choix-secteur-primary mt-3">{{ 'Bonjour %prenom%! Bienvenue sur Pixelforce'|trans({'%prenom%': app.user.prenom|default('')}) }} </h1>    

        {% if app.session.get('enabledContent') == true %}
            {% if app.request.get('stripe_checkout') == 'successfully' %}
                <div class="text-center alert alert-success h5">
                    {% trans %}Paiement efféctué avec succès !{% endtrans %}
                </div>
            {% endif %}
            <div class="row pt-3">
                <div class="col-12 col-md-5">
                    <h6 class="">{% trans %}Découvrez comment Pixelforce peut transformer votre activité. Regardez cette courte vidéo pour en savoir plus sur les opportunités qui vous attendent.{% endtrans %} </h6>
                </div>
                <div class="col-0 col-md-7"></div>
            </div>
            <div class="row video-swipper-container pt-3" style="min-height:700px;" >
                <div class="col-md-8 d-flex align-items-center">
                    <div class="ratio ratio-16x9">
                        <iframe id="secteurVideo" src="{{video_information_vimeo_src}}" allow="autoplay; fullscreen; picture-in-picture; clipboard-write"></iframe>
                        <script src="https://player.vimeo.com/api/player.js"></script>
                    </div>
                </div>

                <div class="col-md-4 d-flex align-items-center" >
                    <div class="row d-flex align-items-center mx-3">
                       
                        <div class="swiper custom-sector " style=" height: 680px;">
                        
                            <div class="swiper-wrapper my-custom-swiper-wrapper" >
                            {% for secteur in allSecteurs|batch(2) %}
                                <div class="swiper-slide d-flex align-items-center">
                                    <div class="row w-100">
                                        <div class="up-arrow-button text-center arrow-swiper">
                                            <i class="fas fa-chevron-up"></i>
                                        </div>
                                        {% for s in secteur %}
                                            {% set agentSecteur = repoAgentSecteur.findOneBy({'secteur' : s, 'agent' : agent}) %}
                                            
                                            <div class="col-12 col-md-12 d-flex align-items-center ">
                                                <div class="card choix-secteur-card w-100">
                                                  <div class="d-flex align-items-center justify-content-center " style="height: 180px; background-color: #6A5FB2; overflow: hidden;">
                                                        {% if s.affiche %}
                                                            
                                                            <img src="{{ asset('files/') }}/{{ s.affiche }}" 
                                                                class="img-fluid" 
                                                                style="max-height: 100%; max-width: 100%; object-fit: contain;" 
                                                                alt="...">
                                                    
                                                                
                                                        {% endif %}
                                                    </div>
                                                    <div class="card-body choix-secteur-card-body rounded-bottom d-flex align-items-end">
                                                        <div class="row card-body-part-a w-100" >
                                                            <div class="col-8 d-flex align-items-center">
                                                                <h5 class=" text-white fw-bold m-0">{{ s.nom }}</h5>
                                                                {# <p class="card-text">{{ s.description }}</p> #}
                                                            </div>
                                                            <div class="col-4 text-end">
                                                                {% if agentSecteur is null and s.active > 0 %}
                                                                    <!-- <a href="" class="btn btn-primary" disabled><i class="fa-solid fa-location-arrow"></i> Découvrir</a> -->
                                                                    <a href="{{ path('agent_add_sector', {id: s.id}) }}" class="regular-white-button   font-weight-bold rounded-3 pl-3 pr-3"> {% trans %}Ajouter{% endtrans %} </a>
                                                                    {% elseif agentSecteur and agentSecteur.statut == true and s.active > 0 %}
                                                                        <a href="{{ path('agent_generate_sessionSecteur_before_redirect_to_route_dahsboard', {id: s.id}) }}" class="regular-white-button  font-weight-bold rounded-3 pl-3 pr-3"> {% trans %}Accéder{% endtrans %} </a>
                                                                    {% elseif agentSecteur and agentSecteur.statut == false and s.active > 0 %}
                                                                        <a class="regular-white-button   font-weight-bold rounded-3 pl-3 pr-3"> {% trans %}En attente de validation{% endtrans %}</a>
                                                                {% else %}
                                                                    <a href="#" class="btn btn-primary" disabled>{% trans %}Bientôt Disponible{% endtrans %}</a>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                        <div class="down-arrow-button  text-center arrow-swiper mt-0">
                                            <i class="fas fa-chevron-down"></i>
                                        </div>

                                    </div>
                                </div>
                            {% endfor %}
                            
                            </div>
                    
                        

                        </div>
                    
                    </div>
                </div>
            </div>
            
            
            {# <h1 class="choix-secteur-primary mt-5 ml-5">Choisissez votre secteur</h1>
            <div class="row pt-3 ml-5">
                <div class="col-12 col-md-5">
                    <h6 class="">Maintenant que vous connaissez les opportunités offertes par Pixelforce, sélectionnez le secteur qui correspond le mieux à votre activité.</h6>
                </div>
                <div class="col-0 col-md-7"></div>
            </div> #}
                
           
                
            
        {% else %}
            <div class="row mt-3">
                <div class="col-12 col-md-6 mx-auto">
                    <div class="alert alert-warning text-center">
                        {% if accountStatus == USER_ACCOUNT_STATUS['UNPAID']  %}
                            {% set agent_accountStatus = USER_ACCOUNT_STATUS['UNPAID'] %}
                            <h5 class="text-warning"> Veuillez procéder au paiement pour activer votre compte </h5>
                        {% elseif expiredAccount %}
                            {% set agent_accountStatus = USER_ACCOUNT_STATUS['EXPIRED'] %}
                            Votre essaie de 14 jours sur PixelForce est expirée, veuillez procéder au paiement pour reactiver votre compte
                            <span class="mt-2">...Ou contacter le responsable pour plus d'informations</span>
                        {% endif %}

                         <div class="alert alert-secondary mt-3">
                            {% set agent = app.user %}
                            {% set agentSecteurs = repoAgentSecteur.findBy({'agent' : agent}) %}
                            <i class="fa-solid fa-circle-info me-1"></i> 
                            Vous avez choisi le(s) secteur(s) suivant(s) : <span class="fw-bolder"> {{ agent.allSecteursOfUser(agentSecteurs) }}</span>. 
                            Vous pouvez vous abonner pour seulement  <span class="fw-bolder">{{ planPrice }} euro/mois</span>.
                        </div>
                    </div>

                    <!-- Stripe form -->
                    <form  method="post" id="subscription-payment-form">
                        <div id="card-errors" role="alert"></div>
                        <div id="card-elements"></div>
        
                        <div class="w-100 text-center">
                            <button id="card-button-submit" class="btn btn-primary mt-3"><i class="fa-solid fa-cart-shopping me-1"></i> <span class="label-button">{{ stripe_defaultButton }}</span> <span class="loader-submit"></span></button>
                        </div>
                    </form>
                </div>
            </div>
         

          
            <input type="hidden" id="agent_accountStatus" value="{{ agent_accountStatus }}">
            <input type="hidden" id="sessionAgentId" value="{{ agent.id }}">
            <input type="hidden" id="planSubscriptionId" value="{{ plan.id }}">
            <input type="hidden" id="stripe_stripePriceId" value="{{ plan.stripePriceId }}">
            <input type="hidden" id="stripe_stripePriceName" value="{{ plan.stripePriceName }}">
            <input type="hidden" id="stripe_stripeToken" value="{{ stripe_publishable_key }}">
            <input type="hidden" id="stripe_clientSecret" value="{{ stripeIntentSecret }}">
            <input type="hidden" id="stripe_url_stripeSubscription" value="{{ path('agent_stripe_subscription_plan_account_execute') }}">
            <input type="hidden" id="stripe_urlSuccessTransaction" value="{{ path('agent_home') }}">
		    <input type="hidden" id="stripe_urlErrorTransaction" value="{{ path('agent_home') }}">
            <input type="hidden" id="stripe_defaultButton" value="{{ stripe_defaultButton }}">
            
            <input type="hidden" id="stripe_nameHolder" value="{{ agent.prenom }}">
            <input type="hidden" id="stripe_emailHolder" value="{{ agent.email }}">
            <input type="hidden" id="stripe_PostalCodeHolder" value="{{ agent.codePostal }}">     
        {% endif %}

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if app.session.get('enabledContent')  == false  %}
        <script src="https://js.stripe.com/v3/"></script>     
        {{ encore_entry_script_tags('StripeAgentRegistrationSubscription') }}
    {% endif %}

    <script>
        $(function() {
            $( ".card-secteur" ).each(function( index ) {
                $(this).mouseover(function(){
                    $(this).css("box-shadow", "12px 12px 2px 1px rgba(0, 0, 0, .2)");
                    $(this).find('.secteur-info').removeClass('d-none');
                });
              
                $(this).mouseout(function(){
                    $(this).find('.secteur-info').addClass('d-none');
                    $(this).css("box-shadow", "none");
                });
            });
        })
    </script>
    {% if app.user.haveSeenSectorVideo == constant('App\\Entity\\User::HAVENT_SEEN_SECTOR_VIDEO') %}
        <script type="text/javascript">
            $(document).ready(function (){
                var iframe = document.getElementById('secteurVideo');
                    const player = new Vimeo.Player(iframe);
                    player.on('ended', () => {
                        console.log('video ended')
                        $('#finishVideoSecteur').submit();
                    });
                    player.play();
                })
        </script>
    {% endif %}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
    $(document).ready(function() {
        const swiper = new Swiper('.swiper', {
            // Optional parameters
            direction: 'vertical',
            loop: true,

            slidesPerView: 'auto',

        });
        $('.up-arrow-button').click(function() {
            swiper.slidePrev();
        });

        $('.down-arrow-button').click(function() {
            swiper.slideNext();
        });
    }); 
      

        
    </script>
{% endblock %}
