{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Compte{% endtrans %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}

{% endblock %}

{% block body %}
	<div class="row px-3 content-formation">
		<div class="card card-body-custom mt-2 px-5 py-5">
			<div class="row  justify-content-center">
				<div class="col-md-8">
				
					<h1 class='text-center mb-5'>{% trans %}Information sur mon compte Little Ponails !{% endtrans %}</h1>
					<div class="d-flex justify-content-between mb-3">
						<span><span class="h6">{{'Compte' | trans }} :</span>
						{% set accontStatusParam = littlePonailsAgentSecteur.lpnStatusParam %}
							<button class="btn btn-sm btn-{{accontStatusParam.btn_class }}">
								{{
									accontStatusParam.str | trans
								}}
							</button>
						</span>
                        <a href="{{ bo_secteur_little_ponails }}" class="btn btn-primary" target="_blank">
                            {% trans %} Ouvrir mon back-office{% endtrans %} <i class="fas fa-external-link-alt me-2"></i>
                        </a>
                    </div>
					{% if app.session.get('secteurId') == secteur_little_ponails_id and not app.user.isLpnInformationCompleted %}
						<div class="bg-warning bg-opacity-10 border border-warning rounded p-3 d-flex align-items-start mt-3">
							<span class="me-2 fs-5 text-warning">⚠️</span>
							<div class="text-warning">
								{# <strong>Action requise</strong><br> #}
								{% trans %}Vous ne pourrez recevoir vos rémunérations qu'après avoir complété les informations supplémentaires requises.{% endtrans %}
							</div>
						</div>
					{% endif %}
					<!-- First Name Field -->
                  
					<div class="form-group mb-3">
                        <label for="firstname" class="form-label">{% trans %}Prénom{% endtrans %}</label>
                        <input type="text" class="form-control" id="firstname" value="{{ user.prenom }}" disabled>
					</div>

					<!-- Last Name Field -->
					<div class="form-group mb-3">
                        <label for="nom" class="form-label">{% trans %}Nom de famille{% endtrans %}</label>
                        <input type="text" class="form-control" id="nom" value="{{ user.nom }}" disabled>
					</div>

					<!-- Username Field -->
					<div class="form-group mb-3">
                        <label for="username" class="form-label">{% trans %}Nom d'utilisateur sur Little Ponails{% endtrans %}</label>
                        <input type="text" class="form-control" id="username" value="{{ user.prenom }}" disabled>
					</div>

					{% if app.session.get('secteurId') == secteur_little_ponails_id and not app.user.isLpnInformationCompleted %}
						{{ form_start(form, { attr: { id: 'registration-form', enctype: 'multipart/form-data' } }) }}
							
						
							<!-- Supporting Documents Field -->
						
							<div class="form-group mb-3">
								{{ form_row(form.identity) }}
							</div>

						
							<div class="form-group mb-3">
								{{ form_label(form.kbis) }}
								{{ form_widget(form.kbis, {'attr': {'class': 'form-control'}}) }}
								{{ form_errors(form.kbis) }}
							</div>

							{% if needCredentials %}
								<div class="form-group mb-3">
									{{ form_row(form.password) }}
								</div>
							{% endif %}
							
							<button type="submit" class="btn btn-primary">{% trans %}Soumettre{% endtrans %}</button>

						{{ form_end(form) }}

					{% else %}
						<div class="bg-success bg-opacity-10 border border-success rounded p-3 d-flex align-items-start mt-3">
							<span class="me-2 fs-5 text-success">📄</span>
							<div class="text-success">
								<strong>{% trans %}Documents complétés{% endtrans %}</strong><br>
								{% trans %}Vous avez fourni les documents supplémentaires requis.{% endtrans %}
							</div>
						</div>
						<hr>
						{% if littlePonailsAgentSecteur.accountFromPlaformStatus == constant('App\\Entity\\AgentSecteur::ACCOUNT_CREATED') %}
							<div class"next-step-block">
								<h6>{{ 'buy_kit'|trans({'{{ url }}': lpn_starter_kit_shop_url})|raw }}</h6>
								<h6>{{ 'fill_contract_reseller_document'|trans({'{{ url }}': lpn_link_contract_form_link})|raw }} <a href="mailto:{{ lpn_contact_mail }}">{{ lpn_contact_mail }}</a></h6>
								<br>
								<div class="d-flex justify-content-end mb-3">
									<a href="{{ lpn_starter_kit_shop_url }}" class="btn btn-primary mx-1" target="_blank">
										{% trans %}Acheter mon kit de démarrage{% endtrans %} <i class="fas fa-toolbox me-2"></i>
									</a>
									<a href="{{ path('agent_lpn_sign_reseller_contract') }}" class="btn btn-primary mx-1">
										{% trans %}Remplir le contrat de revendeur{% endtrans %} <i class="fas fa-file me-2"></i>
									</a>
								</div>
							</div>
						{% elseif littlePonailsAgentSecteur.accountFromPlaformStatus == constant('App\\Entity\\AgentSecteur::ACCOUNT_WAITING_FOR_VALIDATION') %}
							<div class="bg-warning bg-opacity-10 border border-warning rounded p-3 d-flex align-items-start mt-3">
								<span class="me-2 fs-5 text-warning"></span>
								<div class="text-warning">
									{# <strong>Action requise</strong><br> #}
									{% trans %}Votre compte est en cours de validation.{% endtrans %}
								</div>
							</div>
						{% elseif littlePonailsAgentSecteur.accountFromPlaformStatus == constant('App\\Entity\\AgentSecteur::ACCOUNT_INACTIVE') %}
							<div class="bg-danger bg-opacity-10 border border-danger rounded p-3 d-flex align-items-start mt-3">
								<span class="me-2 fs-5 text-danger"></span>
								<div class="text-danger">
									{# <strong>Action requise</strong><br> #}
									{% trans %}Votre compte a été désactivé.{% endtrans %}
								</div>
							</div>
						{% endif %}

					{% endif %}
					
				</div>
			</div>
		</div>
	</div>
{% endblock %}
{% block javascripts %}
	{{ parent() }}
	
{% endblock %}
