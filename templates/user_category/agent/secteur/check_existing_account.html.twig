{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Compte{% endtrans %} 
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	
{% endblock %}

{% block body %}
	<div class="row px-3 content-formation">
		<div class="card card-body-custom mt-2 px-5 py-5">
			<h1>{% trans %}Bienvenue !{% endtrans %}</h1>
            <p>{% trans %}Avez-vous déjà un compte sur la plateforme de Litte Ponails ?{% endtrans %}</p>

            {{ form_start(form) }}
                {{ form_row(form.identifier) }}
                <div class="btn-wrap">
                    <button class="btn btn-primary" type="submit">{% trans %}Vérifier{% endtrans %}</button>
                </div>
            {{ form_end(form) }}
            <p>{% trans %}Vous n'avez pas encore de compte ? {% endtrans %}<a href="{{ path('agent_create_platform_secteur_account') }}" >{% trans %}Créez-en un ici {% endtrans %}</a></p>
            {# <p>Vous n'avez pas encore de compte ? <a href="{{ bo_secteur_little_ponails ~ "/auth/register"}}" target="_blank">Créez-en un ici </a></p> #}
		</div>
	</div>
{% endblock %}


