{% extends 'base.html.twig' %}

{% block title %}
	Chiffre d'affaires - Détail
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <a href="{{ path('agent_ca_list_digital') }}" class="btn btn-secondary mb-2 mt-3"> <i class="fa-solid fa-circle-arrow-left"></i> Retour </a>
    <div class="block block--bordered block--rounded">
        <div class="block__header mb-3" >
            <h1 class="block__title">Vente du mois de "{{ month | date('m-Y')}}" :</h1>
            
        </div>
        {% if orderList|length ==0 %}
                <div class="alert alert-primary p-3 text-center" role="alert">
                    <div class="alert-body">
                        Aucune commande.
                    </div>
                </div>
        {% endif %}
        {% if orderList|length !=0 %}
        <p class=""><span class="fw-bold">Chiffre d'affaires total du mois:</span> {{ totalAmount  | number_format(2, ',', ' ') }} €</p>
        <div class="table-responsive mb-1">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Pack - (service)</th>
                        <th>Montant</th>
                        <th>Référence</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orderList %}
                    <tr>
                        <td>{{order.createdAt | date("d/m/Y H:i")}}</td>
                        <td>{{order.infoClient.firstName}} {{order.infoClient.lastName}}</td>
                        <td>{{order.package.name}} - ({{order.package.service}})</td>
                        <td class="text-right">{{order.amount | number_format(2, ',', ' ') }}</td>
                        <td>
                            <a href="{{ path('agent_order_list_digital',{'referenceVente' : order.infoClient.referenceVente }) }}">{{order.infoClient.referenceVente}}</a>
                            {# <a class="p-2" href="#" onclick="copyLink('{{ url('agent_order_list_digital',{'referenceVente' : order.infoClient.referenceVente }) }}','Liens de la référence {{  order.infoClient.referenceVente }} copié avec succès') "><i class="fa-solid fa-copy"></i></a>  #}
                        </td>
                        <td>{{order.statusStr}}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-center scale-up-center">
            {{ knp_pagination_render(orderList) }}
        <div>
        {% endif %}
    </div>

{% endblock %}


