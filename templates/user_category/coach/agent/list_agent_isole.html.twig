{% extends 'base.html.twig' %}

{% block title %}
	Liste des agents isolés
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="block block--bordered block--rounded">	
    <div class="mt-3">
        <!-- Message alert -->
        <div class="alert-message">
            {% for label, messages in app.flashes %}
                <div class="alert alert-{{label}} text-center">
                    {% for message in messages %}
                        {{message | raw}}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <!-- Formulaire de recherche -->
        <div class="search-form">
         
        </div>

        <!-- Liste agent -->
        <div class="row mb-3">
            <div class="col-12  mt-2 mt-md-3">
                <div class="row mb-4 mt-3 mt-m-0">
                    <div class="col-12 col-md-6 order-2 order-md-1">
                        <h4><i class="fa fa-book-atlas"></i> Liste des agents isolés</h4>
                    </div>
                </div>
            </div>
		</div>
        <div class="table-responsive">
			<table class="table table-striped table-hover text-center">
				<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col" class="text-start">Nom et prénoms</th>
						<th scope="col" class="text-start">Nom d'utilisateur</th>
						<th scope="col">Date inscription</th>
						<th scope="col" class="text-end">CA personnel</th>
					</tr>
				</thead>
				<tbody>
					{% for agent in agents %}
                        <tr>
                            <td>{{ agent.id }}</td>
                            <td class="text-start">{{ agent.fullName }}</td>
                            <td class="text-start">{{ agent.username }}</td>
                            <td>{{ agent.createdAt|date('d/m/Y') }}</td>
                            <td class="text-end">
                                {% if agentsCaAmount[agent.id] is defined %}
                                    {{  agentsCaAmount[agent.id]  | number_format(2, ',', ' ')}}
                                {% else %}
                                    0
                                {% endif %}
                            
                            €</td>
                           
                        </tr>
						
					{% endfor %}

				</tbody>
			</table>
		</div>

		<div class="pagination d-flex justify-content-center">
			{{ knp_pagination_render(agents)}}
		</div>
    </div>
</div>
{% endblock %}
