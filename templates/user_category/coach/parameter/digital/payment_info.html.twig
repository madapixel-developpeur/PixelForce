{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Information paiement{% endtrans %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %} 
    <div class="block block--bordered block--rounded">
        <h1 class="block__text block__text--center mt-2" >Modifier les informations</h1>
            {{ form_start(form, {attr:{
                enctype:"multipart/form-data",
                'class': 'my-form'
            }}) }}
            {{ form_rest(form) }}
            <div>
                <button class="btn btn-primary" type="submit">Enregistrer</button>
            </div>
            {{ form_end(form) }}
    </div>
{% endblock %}


