{% extends 'base.html.twig' %}

{% block title %}
	Catalogues - Secteur
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
          .icon-img{
            max-width: 100%;  /* L'image ne dépasse pas la cellule */
            height: auto;  /* Ajuste la hauteur en conservant le ratio */
            display: block; 
        }
    </style>
{% endblock %}

{% block body %} 
<div class="block block--bordered block--rounded">
    <h1 class="block__text block__text--center mt-2" >Options de filtre :</h1>
    <div class="filter-wrap">
        
        {{ form_start(form, {'attr': {'class': 'filter-form'}}) }}
            
            <div class="my-form-widget">
                {{form_label(form.title)}}
                {{form_widget(form.title)}}
                {{form_errors(form.title)}}
            </div>
            <div class="my-form-widget">
                {{form_label(form.shortDescription)}}
                {{form_widget(form.shortDescription)}}
                {{form_errors(form.shortDescription)}}
            </div>
            <div class="my-form-widget">
                {{form_label(form.redirectionUrl)}}
                {{form_widget(form.redirectionUrl)}}
                {{form_errors(form.redirectionUrl)}}
            </div>
            <div class="btn-wrap">
                <button class="btn btn-primary" type="submit"><i data-feather="filter"></i>Filtrer</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
<div class="block block--bordered block--rounded">
        {% for label, message in app.flashes %}
            <div class="alert alert-{{label}} p-3 text-center" role="alert">
                <div class="alert-body">
                    {{message}}
                </div>
            </div>
        {% endfor %}
        <div class="block__header mb-1" >
            <h1 class="block__title">Liste des services :</h1>
            <div class="fab-btn-wrap">
                <a  href="{{path('app_catalogues_product_sector_add')}}" class="btn btn-primary btn--rounded fab-btn"><i data-feather="plus"></i>Ajouter</a>
            </div>
        </div>
        {% if result|length ==0 %}
                <div class="alert alert-primary p-3 text-center" role="alert">
                    <div class="alert-body">
                        Aucun résultat.
                    </div>
                </div>
        {% endif %}
        {% if result|length > 0 %}
        <div class="table-responsive mb-1">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th class="col-2">Titre</th>
                        <th class="col-3">Description</th>
                        <th class="col-2" >Lien de redirection</th>
                        <th  class="col"></th>
                        <th  class="col"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in result %}
                    <tr>
                        <td>{{ item.title | raw }}</td>
                        <td>{{ item.shortDescription }}</td>
                        <td><a href="{{ item.redirectionUrl }}" target="_blank">{{ item.redirectionUrl }}</a></td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="img">
                                    <img src="{{ asset('files/' ~ item.image ) }}" class="icon-img" alt="{{ item.title }}">
                                </div>
                            </div>
                        </td>
                        <td class="justify-content-center d-flex h-100">
                            <a href="{{ path('app_catalogues_product_edit', {'id': item.id}) }}" class="btn btn-success ms-1">
                                <i class="fas fa-edit"></i>
                            </a>
                            {% set formId = 'delete-form-'~ item.id %}
                            <form method="post" id="{{ formId }}" class="ms-1" style="display: inline-block;" onsubmit="confirmationForm('{{ formId }}','{{ path('app_catalogues_product_delete', { id : item.id })  }}','Êtes-vous sûr(e) de vouloir supprimer ce produit?')">
                                <button class="btn btn-danger"><i class="fas fa-trash-alt"></i></button>
                            </form>  
                        </td>
                       
                        
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            
        </div>
        <div class="d-flex justify-content-center scale-up-center">
            {{ knp_pagination_render(result) }}
        <div>
        {% endif %}
    </div>

{% endblock %}