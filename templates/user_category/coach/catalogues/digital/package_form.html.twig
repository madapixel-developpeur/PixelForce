{% extends 'base.html.twig' %}

{% block title %}
	Package 
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %} 
    <a href="{{ path('coach_package_digital_list') }}" class="btn btn-secondary my-3"> <i class="fa-solid fa-circle-arrow-left"></i> Retour </a>
    <div class="block block--bordered block--rounded">
        <h1 class="block__text block__text--center mt-2" >
            {% if isEdit %}
                Modification
            {% else %}
                Création     
            {% endif %}
            - Package
        </h1>
            {{ form_start(form, {attr:{
                enctype:"multipart/form-data",
                'class': 'my-form'
            }}) }}
            {{ form_rest(form) }}
            <div>
                <button class="btn btn-primary" type="submit">
                    {% if isEdit %}
                        Modifier
                    {% else %}
                        Créer     
                    {% endif %}
                </button>
            </div>
            {{ form_end(form) }}
    </div>
{% endblock %}


