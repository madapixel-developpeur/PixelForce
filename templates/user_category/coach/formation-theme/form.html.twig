{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Thème de formation{% endtrans %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %} 
    <div class="block block--bordered block--rounded">
        <h1 class="block__text block__text--center mt-2" >{% if isEdit %}{% trans %}Modifier le thème de formation{% endtrans %}{% else %} {% trans %}Ajouter un thème de formation{% endtrans %}{% endif %} :</h1>
            
            {{ form_start(form, {'attr': {'class': 'my-form', 'id': form.vars.id}}) }}
                {% for label, messages in app.flashes() %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }}">
                            <div class="alert-body">
                            {{ message }}
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
                <div class="my-form-widget">
                    {{form_label(form.titre)}}
                    {{form_widget(form.titre)}}
                    {{form_errors(form.titre)}}
                </div>
                <div class="my-form-widget">
                    {{form_label(form.categorieFormation)}}
                    {{form_widget(form.categorieFormation)}}
                    {{form_errors(form.categorieFormation)}}
                </div>
                
                
                
                <div class="btn-wrap">
                    <button class="btn btn-primary" type="submit"><i data-feather="save"></i>{% trans %}Enregistrer{% endtrans %}</button>
                </div>
            {{ form_end(form) }}
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function (){
            

           
        }); 
    </script>

{% endblock %}

