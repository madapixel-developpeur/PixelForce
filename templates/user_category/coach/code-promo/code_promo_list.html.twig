{% extends 'base.html.twig' %}

{% block title %}
	Code promo
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    
{% endblock %}

{% block body %} 
<div class="mt-3">
<div class="block block--bordered block--rounded">
    <h1 class="block__text block__text--center mt-2" >Options de filtre :</h1>
    <div class="filter-wrap">
        
        {{ form_start(form, {'attr': {'class': 'filter-form'}}) }}
            
            <div class="my-form-widget">
                {{form_label(form.title)}}
                {{form_widget(form.title)}}
                {{form_errors(form.title)}}
            </div>
            <div class="my-form-widget">
                {{form_label(form.code)}}
                {{form_widget(form.code)}}
                {{form_errors(form.code)}}
            </div>
            <div class="my-form-widget">
                {{form_label(form.minDiscount)}}
                {{form_widget(form.minDiscount)}}
                {{form_errors(form.minDiscount)}}
            </div>
              <div class="my-form-widget">
                {{form_label(form.maxDiscount)}}
                {{form_widget(form.maxDiscount)}}
                {{form_errors(form.maxDiscount)}}
            </div>
            <div class="my-form-widget">
                {{form_label(form.country)}}
                {{form_widget(form.country)}}
                {{form_errors(form.country)}}
            </div>
            <div class="btn-wrap">
                <button class="btn btn-primary" type="submit"><i data-feather="filter"></i>Filtrer</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
<div class="block block--bordered block--rounded">
        {% for label, message in app.flashes %}
            <div class="alert alert-{{label}} p-3 text-center" role="alert">
                <div class="alert-body">
                    {{message}}
                </div>
            </div>
        {% endfor %}
        <div class="block__header mb-1" >
            <h1 class="block__title">Liste des codes promos :</h1>
            <div class="fab-btn-wrap">
                <a  href="{{ path('code_promo_new') }}" class="btn btn-primary btn--rounded fab-btn"><i data-feather="plus"></i>Ajouter</a>
            </div>
        </div>
        {% if result|length ==0 %}
                <div class="alert alert-primary p-3 text-center" role="alert">
                    <div class="alert-body">
                        Aucun résultat.
                    </div>
                </div>
        {% endif %}
        {% if result|length > 0 %}
        <div class="table-responsive mb-1">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th >Titre</th>
                        <th class="text-center">Code</th>
                        <th class="text-start">Validité</th>
                        <th class="text-end">Promo</th>
                        <th class="text-center">Pays</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in result %}
                    <tr>
                        <td>{{ item.title }}</td>
                        <td class="text-center">{{ item.code }}</td>
                        <td class="text-start">
                            <b>Début :</b> {{ item.startDate | date('Y-m-d à H:m:s')  }} </br>
                            <b>Fin :</b> {{ item.endDate ? item.endDate | date('Y-m-d à H:m:s') : '...'  }} </br>
                           </br>
                        </td>
                        <td class="text-end">
                            {{ item.discount}} %
                        </td>
                        <td class="text-center">
                             {{ item.countryNameListString}} 
                        </td>
                        <td class="justify-content-center d-flex h-100">
                            <a href="{{ path('code_promo_edit', {'id': item.id}) }}" class="btn btn-success ms-1">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" id="code_promo_delete" class="ms-1" style="display: inline-block;" onsubmit="confirmationForm('code_promo_delete','{{ path('code_promo_delete', { id : item.id })  }}','Êtes-vous sûr(e) de vouloir supprimer ce code promo?')">
                                <button class="btn btn-danger"><i class="fas fa-trash-alt"></i></button>
                            </form>  
                        </td>
                       
                        
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            
        </div>
        <div class="d-flex justify-content-center scale-up-center">
            {{ knp_pagination_render(result) }}
        <div>
        {% endif %}
    </div>
</div>

{% endblock %}