{% extends 'base.html.twig' %}

{% block title %}
	Code promo
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %} 
    <a href="{{ path('code_promo_list') }}" class="btn btn-secondary my-3"> <i class="fa-solid fa-circle-arrow-left"></i> Retour </a>
    <div class="block block--bordered block--rounded">
        <h1 class="block__text block__text--center mt-2" >{% if codePromo is defined %}Modifier le code promo{% else %} Ajouter un code promo{% endif %}</h1>
            {{ form_start(form, {attr:{
                'class': 'my-form'
            }}) }}

            {{ form_row(form.title) }}
            {{ form_row(form.code) }}
            {{ form_row(form.discount) }}
            {{ form_row(form.startDate) }}
            {{ form_row(form.endDate) }}
            {{ form_row(form.countries, {'attr': {'class': 'select2-countries'}}) }}
            {{ form_rest(form) }}

            <div>
                <button class="btn btn-primary" type="submit">Enregistrer</button>
            </div>
            {{ form_end(form) }}
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.select2-countries').select2();
        });
    </script>
{% endblock %}


